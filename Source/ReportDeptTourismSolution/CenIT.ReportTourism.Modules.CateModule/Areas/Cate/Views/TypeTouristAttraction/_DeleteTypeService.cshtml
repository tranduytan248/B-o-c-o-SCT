@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.TouristAttraction.CateTouristAttractionTypeServiceModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Enterprise_TouristAttraction_TypeService_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("DeleteTypeService", "TypeTouristAttraction", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "TouristAttractionTypeService_OnProcessSuccess(data, 'DeleteTypeService')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.TouristAttractionTypeServiceId)
        @Html.HiddenFor(model => model.EnterpriseId)
        @Html.HiddenFor(model => model.ServiceName)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.Accommodation.CateAccommodationServiceInfrastructureModel
@Html.AntiForgeryToken()

@using (Html.BeginForm("SaveInfrastructure", "Accommodation", new { area = "" }, FormMethod.Post, new { encType = "multipart/form-data", id = "SaveInfrastructure", @class = "form-horizontal" }))
{
    @Html.HiddenFor(model => model.EnterpriseId)

    <div class="box-body" id="bodyForm">
        <div class="form-group">
            @Html.TitleFor(model => model.InitialInvestmentCapital, new { @class = "control-label col-md-3" })
            <div class="col-md-2">
                <div class="input-group col-md-12">
                    @Html.TextBoxFor(model => model.InitialInvestmentCapitalView, new { @class = "form-control", min = 0, placeholder = "0", onblur = "OnFormatCurrency(this, '#InitialInvestmentCapital');", onfocus = "OnFocusCurrency(this, '#InitialInvestmentCapital');" })
                    @*<span class="input-group-addon">đồng</span>*@
                </div>
                @Html.HiddenFor(model => model.InitialInvestmentCapital)
                @Html.ValidationMessageFor(model => model.InitialInvestmentCapital, "", new { @class = "text-danger" })
            </div>
            @Html.TitleFor(model => model.UpgradeInvestmentCapital, new { @class = "control-label col-md-3" })
            <div class="col-md-2">
                <div class="input-group col-md-12">
                    @Html.TextBoxFor(model => model.UpgradeInvestmentCapitalView, new { @class = "form-control", min = 0, placeholder = "0", onblur = "OnFormatCurrency(this, '#UpgradeInvestmentCapital');", onfocus = "OnFocusCurrency(this, '#UpgradeInvestmentCapital');" })
                    @*<span class="input-group-addon">đồng</span>*@
                </div>
                @Html.HiddenFor(model => model.UpgradeInvestmentCapital)
                @Html.ValidationMessageFor(model => model.UpgradeInvestmentCapital, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.TitleFor(model => model.TotalArea, new { @class = "control-label col-md-3" })
            <div class="col-md-2">
                <div class="input-group col-md-12">
                    @Html.TextBoxFor(model => model.TotalArea, new { @class = "form-control", onchange = "(function(el){el.value=parseFloat(el.value).toFixed(2);})(this)", type = "number", step = "0.01", min = 0, placeholder = "0", onblur = "OnFormatNumber(this);" })
                    <span class="input-group-addon">m2</span>
                </div>
                @Html.ValidationMessageFor(model => model.TotalArea, "", new { @class = "text-danger" })
            </div>
            @Html.TitleFor(model => model.TotalConstructionArea, new { @class = "control-label col-md-3" })
            <div class="col-md-2">
                <div class="input-group col-md-12">
                    @Html.TextBoxFor(model => model.TotalConstructionArea, new { @class = "form-control", onchange = "(function(el){el.value=parseFloat(el.value).toFixed(2);})(this)", step = "0.01", type = "number", min = 0, placeholder = "0", onblur = "OnFormatNumber(this);" })
                    <span class="input-group-addon">m2</span>
                </div>
                @Html.ValidationMessageFor(model => model.TotalConstructionArea, "", new { @class = "text-danger" })
            </div>
        </div>

        @{
            if (Model.TotalRoom > 0)
            {
                <div class="form-group">
                    @Html.TitleFor(model => model.TotalRoom, new { @class = "control-label col-md-3" })
                    <div class="col-md-2">
                        @Html.TextBoxFor(model => model.TotalRoom, new { @class = "form-control", @readonly = true, min = 0, placeholder = "0" })
                        @Html.ValidationMessageFor(model => model.TotalRoom, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">
                    @Html.TitleFor(model => model.TotalRoom, new { @class = "control-label col-md-3" })
                    <div class="col-md-2">
                        @Html.TextBoxFor(model => model.TotalRoom, new { @class = "form-control", min = 0, placeholder = "0" })
                        @Html.ValidationMessageFor(model => model.TotalRoom, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
        }


        @Html.Partial("_InfrastructureRooms")
        <hr/>
        <div class="form-group">
            @Html.TitleFor(model => model.Reason, new { @class = "control-label col-md-3" })
            <div class="col-md-9">
                @Html.TextAreaFor(model => model.Reason, new { rows = "3", @class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
                @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="box-footer">
        <button type="button" class="btn btn-primary pull-right" onclick="$('form#SaveInfrastructure').submit();"><i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Save")</button>
    </div>
}

<script type="text/javascript">

    $('form#SaveInfrastructure').ajaxForm({
        success: function(response) {
            if (response.status != undefined) {
                eval(response.message);
                $("#Infrastructures").load('@Url.Action("Infrastructure", new { enterpriseId = Model.EnterpriseId })');
                response.status = undefined;
            } else {
                $("#Infrastructures").html(response);
            }
        }
    });

    function OnFormatCurrency(inptCurrency, ele) {
        var valueCurrency = $(inptCurrency).val();
        if (valueCurrency.length > 0) {
            $(ele).val(parseInt(valueCurrency));
            $(inptCurrency)
                .val(parseInt(valueCurrency).toLocaleString("he-IL", { style: 'currency', currency: 'VND' }));
        }
    }

    function OnFocusCurrency(inptCurrency, ele) {
        var valueCurrency = $(ele).val();
        if (valueCurrency.length > 0) {
            $(inptCurrency).val(valueCurrency);
        }
    }

    function OnFormatNumber(inptNumber) {
        var valueCurrency = $(inptNumber).val();
        $(inptNumber).val(parseFloat(valueCurrency));
    }
</script>
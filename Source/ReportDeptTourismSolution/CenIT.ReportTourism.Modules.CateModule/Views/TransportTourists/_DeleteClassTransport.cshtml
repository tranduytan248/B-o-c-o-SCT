@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.TransportTourists.CateTransportTouristsServiceInfrastructureClassTransportModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Enterprise_TransportTourists_Infrastructure_ClassTransport_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("DeleteClassTransport", "TransportTourists", new { area = "" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "InfrastructureClassTransports_OnProcessSuccess(data, 'DeleteClassTransport')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.InfrastructureClassTransportId)
        @Html.HiddenFor(model => model.EnterpriseId)
        @Html.HiddenFor(model => model.TypeTransportName)
        @Html.HiddenFor(model => model.ClassTransportName)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Modules.CateModule.Models.MyEnterpiseSearchModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Enterprise_Info_Title");
}

@section Title
{
    @ViewBag.Title
}

@section Action
{
}

<div class="row">
    <div class="col-sm-12">
        @Html.Partial("_Search")
    </div>
    <div class="col-sm-12 table-responsive">
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="active">
                    <a href="#EnterpriseInfo" data-toggle="tab" aria-expanded="true">Thông tin Doanh nghiệp</a>
                </li>
                @*<li class="">
                    <a href="#TypeBusinessInfo" data-toggle="tab" aria-expanded="false">Thông tin Lĩnh vực Kinh doanh</a>
                </li>*@
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="EnterpriseInfo">
                    <div class="overlay">
                        <i class="fa fa-refresh fa-spin"></i>
                    </div>
                </div>
                @*<div class="tab-pane" id="TypeBusinessInfo">
                    <div class="overlay">
                        <i class="fa fa-refresh fa-spin"></i>
                    </div>
                </div>*@
            </div>
            <!-- /.tab-content -->
        </div>
    </div>
</div>

@section CustomJS
{
    <script src="@Url.Content("~/Views/MyEnterprise/MyEnterprise.js")"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            OnLoadEnterpriseInfo($("#EnterpriseId"), '#EnterpriseInfo', '#TypeBusinessInfo');
            $('a[data-toggle="tab"]').on('shown.bs.tab',
                function(e) {
                    if ($($(this).attr('href')).has('select').length > 0) {
                        $.each($($(this).attr('href')).find('select'),
                            function(idx, ele) {
                                //if (!$(ele).data('select2')) {
                                $(ele).select2('destroy').select2({
                                    allowClear: true,
                                    placeholder: "Chọn 1 giá trị",
                                    width: "element"
                                });
                                //}
                            });
                    }
                });
        });
    </script>
    @Html.RenderScripts(ScriptPosition.BodyEnd)
}
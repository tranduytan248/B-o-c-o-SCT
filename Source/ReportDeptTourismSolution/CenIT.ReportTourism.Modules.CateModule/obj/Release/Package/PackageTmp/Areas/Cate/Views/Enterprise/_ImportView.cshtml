@model CenIT.ReportTourism.Modules.CateModule.Areas.Cate.Models.EnterpriseImportModel

<div id="Import">
    <div class="form-group">
        @Html.TitleFor(model => model.TypeBusiness, new {@class = "control-label col-md-3"})
        <div class="col-md-9">
            @Html.DropDownListFor(model => model.TypeBusiness, new SelectList(Model.ListTypeBusiness, "Value", "Text"), "", new {@class = "col-md-9", onchange = "OnChangeCombo(this, '#TypeBusinessName')"})
            @Html.ValidationMessageFor(model => model.TypeBusiness, "", new {@class = "text-danger"})
        </div>
    </div>
    @Html.HiddenFor(model => model.TypeBusinessName)

    <div class="form-group">
        @Html.TitleFor(model => model.FileImportData, new {@class = "control-label col-md-3"})
        <div class="col-md-9">
            @Html.FileFor(model => model.FileImportData, ".xlsx,.xls", true, new {@class = "col-md-8"})
            @Html.ValidationMessageFor(model => model.FileImportData, "", new {@class = "text-danger"})
        </div>
    </div>
</div>
@Html.RenderScripts(ScriptPosition.BodyInside)
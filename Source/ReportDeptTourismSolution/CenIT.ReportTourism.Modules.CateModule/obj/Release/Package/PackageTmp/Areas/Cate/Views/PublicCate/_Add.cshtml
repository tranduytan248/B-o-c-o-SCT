@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("PublicCate_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Html.BeginForm("Add", "PublicCate", new {area = "Cate"}, FormMethod.Post, new {encType = "multipart/form-data", id = "AddPublicCate", @class = "form-horizontal"}))
    {
        <div id="bodyForm">
            @Html.Partial("_PublicCate")
        </div>
    }
    <script type="text/javascript">
        $('form').ajaxForm({
            success: function(response) {
                if (response.status != undefined) {
                    $("#ModalContent #modal_AddPublicCate").modal("hide");
                    $("#ModalContent #modal_AddPublicCate").on('hidden.bs.modal',
                        function() {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tablePublicCate.ajax.reload(null, null);
                                response.status = undefined;
                            }
                        });
                } else {
                    $("#ModalContent #modal_AddPublicCate" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateNationalModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("National_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "National", new {area = "Cate"}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AppNational_OnProcessSuccess(data, 'DeleteNational')"
    }, new {@class = "form-horizontal"}))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.NationalId)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
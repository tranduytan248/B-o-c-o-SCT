@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("Enterprise_Traveling_BranchOffice_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-pencil"></i>
}

@section FormBody{
    @using (Html.BeginForm("EditBranchOffice", "TypeTraveling", new {area = "Cate"}, FormMethod.Post, new {encType = "multipart/form-data", id = "EditBranchOffice", @class = "form-horizontal"}))
    {
        <div id="bodyForm">
            @Html.Partial("_BranchOffice")
        </div>
    }
    <script type="text/javascript">
        $('form').ajaxForm({
            success: function(response) {
                if (response.status != undefined) {
                    $("#ModalContent #modal_EditBranchOffice").modal("hide");
                    $("#ModalContent #modal_EditBranchOffice").on('hidden.bs.modal',
                        function() {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableBranchOffice.ajax.reload(null, false);
                                response.status = undefined;
                            }
                        });
                } else {
                    $("#ModalContent #modal_EditBranchOffice" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateNationalModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new {@class = "text-danger"})
<div id="Message">
    <div class="form-group">
        @Html.TitleFor(model => model.NationalCode, new {@class = "control-label col-md-3"})
        @Html.HiddenFor(model => model.NationalId)
        <div class="col-md-9">
            @Html.TextBoxFor(model => model.NationalCode, new {@class = "col-md-7", placeholder = AppProcessor.Messagor.GetMessage("National_Label_NationalCode")})
            <br/> @Html.ValidationMessageFor(model => model.NationalCode, "", new {@class = "text-danger"})
        </div>

    </div>
    <div class="form-group">
        @Html.TitleFor(model => model.NationalName, new {@class = "control-label col-md-3"})
        @Html.HiddenFor(model => model.NationalId)
        <div class="col-md-9">
            @Html.TextBoxFor(model => model.NationalName, new {@class = "col-md-7", placeholder = AppProcessor.Messagor.GetMessage("National_Label_NationalName")})
            <br/>@Html.ValidationMessageFor(model => model.NationalName, "", new {@class = "text-danger"})
        </div>

    </div>
    <div class="form-group">
        @Html.TitleFor(model => model.ContinentId, new {@class = "control-label col-md-3"})
        <div class="col-md-9">
            @Html.DropDownListFor(model => model.ContinentId, new SelectList(Model.ListContinent, "Value", "Text"), "", new {@class = "col-md-7", onchange = "OnChangeCombo(this, '#ContinentName');"})
            <br/> @Html.ValidationMessageFor(model => model.ContinentId, "", new {@class = "text-danger"})
            @Html.HiddenFor(model => model.ContinentName)
        </div>
    </div>

</div>
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.TransportTourists.CateTransportTouristsServiceInfrastructureClassTransportModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new {@class = "text-danger"})
@Html.HiddenFor(model => model.InfrastructureClassTransportId)
@Html.HiddenFor(model => model.EnterpriseId)

<div id="TypeTransport">
    <div class="form-group">
        @Html.TitleFor(model => model.TypeTransport, new {@class = "control-label col-md-4"})
        <div class="col-md-8">
            @Html.DropDownListFor(model => model.TypeTransport, new SelectList(Model.ListTypeTransports, "Value", "Text"), "", new {@class = "col-md-8", onchange = "OnChangeCombo(this, '#TypeTransportName')"})
            @Html.ValidationMessageFor(model => model.TypeTransport, "", new {@class = "text-danger"})
            @Html.HiddenFor(model => model.TypeTransportName)
        </div>
    </div>

    <div class="form-group">
        @Html.TitleFor(model => model.ClassTransportName, new {@class = "control-label col-md-4"})
        <div class="col-md-8">
            @Html.TextBoxFor(model => model.ClassTransportName, new {@class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("TransportTouristsInfrastructure_Label_ClassTransport")})
            @Html.ValidationMessageFor(model => model.ClassTransportName, "", new {@class = "text-danger"})
        </div>
    </div>

    <div class="form-group">
        @Html.TitleFor(model => model.TotalTransport, new {@class = "control-label col-md-4"})
        <div class="col-md-8">
            @Html.TextBoxFor(model => model.TotalTransport, new {type = "number", min = 0, @class = "col-md-3", placeholder = "0", onblur = "OnFormatNumber(this);"})
            @Html.ValidationMessageFor(model => model.TotalTransport, "", new {@class = "text-danger"})
        </div>
    </div>

    @{
        if (Model.InfrastructureClassTransportId <= 0)
        {
            @Html.HiddenFor(model => model.Reason)
        }
        else
        {
            <div class="form-group">
                @Html.TitleFor(model => model.Reason, new {@class = "control-label col-md-4"})
                <div class="col-md-8">
                    @Html.TextAreaFor(model => model.Reason, new {rows = "3", @class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title")})
                    @Html.ValidationMessageFor(model => model.Reason, "", new {@class = "text-danger"})
                </div>
            </div>
        }
    }

</div>

<script type="text/javascript">
    function OnFormatNumber(inptNumber) {
        var valueCurrency = $(inptNumber).val();
        $(inptNumber).val(parseInt(valueCurrency));
    }

</script>
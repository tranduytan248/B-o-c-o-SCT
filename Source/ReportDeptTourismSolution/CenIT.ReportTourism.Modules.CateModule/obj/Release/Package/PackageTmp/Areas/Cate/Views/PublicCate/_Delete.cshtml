@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CatePublicCateModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("PublicCate_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "PublicCate", new {area = "Cate"}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "PublicCate_OnProcessSuccess(data, 'DeletePublicCate')"
    }, new {@class = "form-horizontal"}))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CateId)
        @Html.HiddenFor(model => model.CateName)
        @Html.HiddenFor(model => model.CateTypeId)
        @Html.HiddenFor(model => model.CateTypeName)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
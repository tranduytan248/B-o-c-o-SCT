@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.Accommodation.CateAccommodationServiceModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new {@class = "text-danger"})
@Html.HiddenFor(model => model.EnterpriseId)


<div class="nav-tabs-custom">
    <ul class="nav nav-tabs">
        <li class="active">
            <a href="#AccommodationInfo" data-toggle="tab" aria-expanded="true">@AppProcessor.Messagor.GetMessage("Enterprise_Accommodation_Info_Title")</a>
        </li>
        <li class="">
            <a href="#Certificate" data-toggle="tab" aria-expanded="true">@AppProcessor.Messagor.GetMessage("Enterprise_Accommodation_Certificate_Title")</a>
        </li>
        <li class="">
            <a href="#Infrastructures" data-toggle="tab" aria-expanded="false">@AppProcessor.Messagor.GetMessage("Enterprise_Accommodation_Infrastructure_Title")</a>
        </li>
        <li class="">
            <a href="#HRInformations" data-toggle="tab" aria-expanded="false">@AppProcessor.Messagor.GetMessage("Enterprise_Accommodation_HRInformation_Title")</a>
        </li>
        <li class="">
            <a href="#TypeServices" data-toggle="tab" aria-expanded="false">@AppProcessor.Messagor.GetMessage("Enterprise_Accommodation_TypeService_Title")</a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="AccommodationInfo">
            @{ Html.RenderAction("AccommodationInfo", Model.EnterpriseId); }
        </div>
        <div class="tab-pane" id="Certificate">
            @{ Html.RenderAction("Certificate", Model.EnterpriseId); }
        </div>
        <div class="tab-pane" id="Infrastructures">
            @{ Html.RenderAction("Infrastructure", Model.EnterpriseId); }
        </div>
        <div class="tab-pane" id="HRInformations">
            @{ Html.RenderAction("HRInformation", Model.EnterpriseId); }
        </div>
        <div class="tab-pane" id="TypeServices">
            @{ Html.RenderAction("TypeService", Model.EnterpriseId); }
        </div>
    </div>
    <!-- /.tab-content -->
</div>
<script src="@Url.Content("~/Areas/Cate/Views/TypeAccommodation/Accommodation.js")"></script>
@Html.RenderScripts(ScriptPosition.BodyInside)
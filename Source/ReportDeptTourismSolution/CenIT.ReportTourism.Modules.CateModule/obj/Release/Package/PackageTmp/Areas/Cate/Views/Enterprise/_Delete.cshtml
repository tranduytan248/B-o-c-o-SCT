@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateEnterpriseModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Enterprise_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Enterprise", new {area = "Cate"}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Enterprise_OnProcessSuccess(data, 'DeleteEnterprise')"
    }, new {@class = "form-horizontal"}))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.EnterpriseId)
        @Html.HiddenFor(model => model.OwnerEnterpriseName)
        @Html.HiddenFor(model => model.BusinessName)
        @Html.HiddenFor(model => model.TypeBusiness)
        @Html.HiddenFor(model => model.TypeBusinessName)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
        <hr/>
        <div class="form-group">
            @Html.TitleFor(model => model.Reason, new {@class = "control-label col-md-3"})
            <div class="col-md-9">
                @Html.TextAreaFor(model => model.Reason, new {rows = "3", @class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title")})
                @Html.ValidationMessageFor(model => model.Reason, "", new {@class = "text-danger"})
            </div>
        </div>
    }
}
    </div>
}

<script type="text/javascript">

    $('form#SaveHRInformation').ajaxForm({
        success: function(response) {
            if (response.status != undefined) {
                eval(response.message);
                $("#HRInformations").load('@Url.Action("HRInformation", new {enterpriseId = Model.EnterpriseId})');
                response.status = undefined;
            } else {
                $("#HRInformations").html(response);
            }
        }
    });
</script>
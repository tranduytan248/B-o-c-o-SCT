@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.Traveling.CateTravelingServiceBranchOfficeModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new {@class = "text-danger"})
@Html.HiddenFor(model => model.BranchOfficeId)
@Html.HiddenFor(model => model.EnterpriseId)
@Html.HiddenFor(model => model.Reason)

<div id="BranchOffice">
    <div class="form-group">
        @Html.TitleFor(model => model.BranchName, new {@class = "control-label col-md-4"})
        <div class="col-md-8">
            @Html.TextBoxFor(model => model.BranchName, new {@class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("TravelingBranchOffice_Label_BranchName")})
            @Html.ValidationMessageFor(model => model.BranchName, "", new {@class = "text-danger"})
        </div>
    </div>
    <div class="form-group">
        @Html.TitleFor(model => model.BranchAddress, new {@class = "control-label col-md-4"})
        <div class="col-md-8">
            @Html.TextAreaFor(model => model.BranchAddress, new {rows = 3, @class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("TravelingBranchOffice_Label_BranchAddress")})
            @Html.ValidationMessageFor(model => model.BranchAddress, "", new {@class = "text-danger"})
        </div>
    </div>
</div>
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.TransportTourists.CateTransportTouristsServiceModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new {@class = "text-danger"})
@Html.HiddenFor(model => model.EnterpriseId)


<div class="nav-tabs-custom">
    <ul class="nav nav-tabs">
        <li class="active">
            <a href="#Certificate" data-toggle="tab" aria-expanded="true">@AppProcessor.Messagor.GetMessage("Enterprise_TransportTourists_Certificate_Title")</a>
        </li>
        <li class="">
            <a href="#HRInformation" data-toggle="tab" aria-expanded="false">@AppProcessor.Messagor.GetMessage("Enterprise_TransportTourists_HRInformation_Title")</a>
        </li>
        <li class="">
            <a href="#Infrastructures" data-toggle="tab" aria-expanded="false">@AppProcessor.Messagor.GetMessage("Enterprise_TransportTourists_Infrastructure_Title")</a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="Certificate">
            @{ Html.RenderAction("Certificate", Model.EnterpriseId); }
        </div>
        <div class="tab-pane" id="HRInformation">
            @{ Html.RenderAction("HRInformation", Model.EnterpriseId); }
        </div>
        <div class="tab-pane" id="Infrastructures">
            @{ Html.RenderAction("Infrastructure", Model.EnterpriseId); }
        </div>
    </div>
    <!-- /.tab-content -->
</div>
<script src="@Url.Content("~/Views/TransportTourists/TransportTourists.js")"></script>
@Html.RenderScripts(ScriptPosition.BodyInside)
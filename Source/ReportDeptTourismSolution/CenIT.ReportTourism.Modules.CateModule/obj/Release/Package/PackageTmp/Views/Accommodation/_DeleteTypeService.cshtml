@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.Accommodation.CateAccommodationServiceTypeServiceModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Enterprise_Accommodation_TypeService_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("DeleteTypeService", "Accommodation", new {area = ""}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "TypeServices_OnProcessSuccess(data, 'DeleteTypeService')"
    }, new {@class = "form-horizontal"}))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.AccommodationTypeServiceId)
        @Html.HiddenFor(model => model.EnterpriseId)
        @Html.HiddenFor(model => model.ServiceId)
        @Html.HiddenFor(model => model.ServiceName)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
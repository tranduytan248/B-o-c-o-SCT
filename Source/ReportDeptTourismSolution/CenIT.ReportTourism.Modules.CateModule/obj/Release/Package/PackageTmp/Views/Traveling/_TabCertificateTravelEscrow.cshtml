@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.Traveling.CateTravelingServiceCertificateTravelEscrowModel
@Html.AntiForgeryToken()

@using (Html.BeginForm("SaveCertificateTravelEscrow", "Traveling", new {area = ""}, FormMethod.Post, new {encType = "multipart/form-data", id = "SaveCertificateTravelEscrow", @class = "form-horizontal"}))
{
    @Html.HiddenFor(model => model.EnterpriseId)
    <div class="box-body" id="bodyForm">
        <div class="form-group">
            @Html.TitleFor(model => model.FileCertificate, new {@class = "control-label col-md-3"})
            <div class="col-md-9">
                @{
                    if (!string.IsNullOrEmpty(Model.CertificateView))
                    {
                        @Html.Raw(Model.CertificateView)
                    }
                }
                @Html.HiddenFor(model => model.CertificateId)
                @Html.FileFor(model => model.FileCertificate, ".docx,.pdf,.xlsx,.xls", false, new {@class = "col-md-8"})
                @Html.ValidationMessageFor(model => model.FileCertificate, "", new {@class = "text-danger"})
            </div>
        </div>
        <div class="form-group">
            @Html.TitleFor(model => model.BankName, new {@class = "control-label col-md-4"})
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.BankName, new {@class = "col-md-7", placeholder = AppProcessor.Messagor.GetMessage("TravelingCertificateTravelEscrow_Label_BankName")})
                @Html.ValidationMessageFor(model => model.BankName, "", new {@class = "text-danger"})
            </div>
        </div>
        <div class="form-group">
            @Html.TitleFor(model => model.BankAccountNo, new {@class = "control-label col-md-4"})
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.BankAccountNo, new {@class = "col-md-4", placeholder = AppProcessor.Messagor.GetMessage("TravelingCertificateTravelEscrow_Label_BankAccountNo")})
                @Html.ValidationMessageFor(model => model.BankAccountNo, "", new {@class = "text-danger"})
            </div>
        </div>

        <div class="form-group">
            @Html.TitleFor(model => model.AnnouncedView, new {@class = "control-label col-md-4"})
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.AnnouncedView, new {@class = "col-md-3", placeholder = "0", onblur = "OnFormatCurrency(this, '#Amount')", onfocus = "OnFocusCurrency(this, '#Amount')"})
                @Html.ValidationMessageFor(model => model.AnnouncedView, "", new {@class = "text-danger"})
                @Html.HiddenFor(model => model.Amount)
            </div>
        </div>

        <hr/>
        <div class="form-group">
            @Html.TitleFor(model => model.Reason, new {@class = "control-label col-md-3"})
            <div class="col-md-9">
                @Html.TextAreaFor(model => model.Reason, new {rows = "3", @class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title")})
                @Html.ValidationMessageFor(model => model.Reason, "", new {@class = "text-danger"})
            </div>
        </div>
    </div>
    <div class="box-footer">
        <button type="button" class="btn btn-primary pull-right" onclick="$('form#SaveCertificateTravelEscrow').submit();"><i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Save")</button>
    </div>
}
<script type="text/javascript">
    $(function() {
        //initDownloadDoc();
    });
    $('form#SaveCertificateTravelEscrow').ajaxForm({
        success: function(response) {
            if (response.status != undefined) {
                eval(response.message);
                $("#CertificateTravelEscrow")
                    .load('@Url.Action("CertificateTravelEscrow", new {enterpriseId = Model.EnterpriseId})');
                response.status = undefined;
            } else {
                $("#CertificateTravelEscrow").html(response);
            }
            _initInputFile_FileCertificate();
            //initDownloadDoc();
        }
    });

    function OnFormatCurrency(inptCurrency, ele) {
        var valueCurrency = $(inptCurrency).val();
        if (valueCurrency.length > 0 && !isNaN(valueCurrency)) {
            $(ele).val(parseInt(valueCurrency));
            $(inptCurrency)
                .val(parseInt(valueCurrency).toLocaleString("he-IL", { style: 'currency', currency: 'VND' }));
        }
    }

    function OnFocusCurrency(inptCurrency, ele) {
        var valueCurrency = $(ele).val();
        if (valueCurrency.length > 0) {
            $(inptCurrency).val(valueCurrency);
        }
    }
</script>
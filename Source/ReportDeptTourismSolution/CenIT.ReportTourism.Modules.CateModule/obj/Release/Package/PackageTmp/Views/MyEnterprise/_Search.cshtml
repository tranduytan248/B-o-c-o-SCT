@model CenIT.ReportTourism.Modules.CateModule.Models.MyEnterpiseSearchModel

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">@*@AppProcessor.Messagor.GetMessage("Condition_Title")*@</h3>
        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="box-body with-border">
        <div class="row form-horizontal" id="Search">
            <div class="col-md-12">
                <div class="form-group">
                    @Html.TitleFor(model => model.EnterpriseId, new {@class = "control-label col-md-3"})
                    <div class="col-md-9">
                        @Html.DropDownListFor(model => model.EnterpriseId, new SelectList(Model.ListEnterprises, "Value", "Text"), new {@class = "col-md-7", onchange = "OnLoadEnterpriseInfo(this, '#EnterpriseInfo', '#TypeBusinessInfo');"})
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
        @*<div class="box-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick=""><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>*@
    </div>
</div>
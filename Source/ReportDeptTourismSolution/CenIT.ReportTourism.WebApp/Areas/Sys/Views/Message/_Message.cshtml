@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysMessageModel

@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@{
    var id = string.Empty;
    var isReadonly = string.Empty;
    if (Model != null)
    {
        if (!string.IsNullOrEmpty(Model.LangCode) && !string.IsNullOrEmpty(Model.LabelKey))
        {
            isReadonly = "readonly";
            id = Model.LangCode + Model.LabelKey;
        }
    }
}
@Html.Hidden("ID", id)
<div id="Message">
    <div class="form-group">
        <div class="col-md-3">
            @Html.TitleFor(model => model.LangCode, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.LangCode, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Message_Label_LangCode") })
            @Html.ValidationMessageFor(model => model.LangCode, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-9">
            @Html.TitleFor(model => model.LabelKey, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.LabelKey, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Message_Label_LabelKey") })
            @Html.ValidationMessageFor(model => model.LabelKey, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.Message, new { @class = "control-label" })
            @Html.TextAreaFor(model => model.Message, new { rows = "2", @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Message_Label_Message") })
            @Html.ValidationMessageFor(model => model.Message, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function() {
        var readonly = "@isReadonly";

        if (readonly.length > 0) {
            $("input[type='text'][id$='LangCode']").attr(readonly, "readonly");
            $("input[type='text'][id$='LabelKey']").attr(readonly, "readonly");
        }
    });
</script>
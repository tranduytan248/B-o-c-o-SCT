@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Function_Title");
}

@section Title
{
    @ViewBag.Title
}

@section Action
{
    @Html.Button(true, "AddFunction", Url.Action("Add", new { area = "Sys" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-sm btn-success pull-right" })
}

<div class="row">
    <div class="col-sm-12">
        <div class="col-sm-12 table-responsive">
            <table id="DSFunction" class="table table-bordered table-striped" width="100%">
                <thead>
                <tr>
                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Function_Label_Area")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Function_Label_Function")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Function_Label_Description")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section CustomJS
{
    <script src="@Url.Content("~/Areas/Sys/Views/Function/Function.js")"></script>
}
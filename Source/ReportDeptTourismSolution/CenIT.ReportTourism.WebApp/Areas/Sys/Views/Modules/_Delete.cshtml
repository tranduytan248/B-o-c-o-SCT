@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysModuleModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Module_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Modules", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Module_OnProcessSuccess(data, 'DeleteModule')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ModuleId)
        @Html.HiddenFor(model => model.ModuleName)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
@model CenIT.ReportTourism.Models.Report.DashboardAnalysisModel
@using System.Web.Mvc
@using System.Linq

@{
    ViewBag.Title = "Phân tích chỉ tiêu";
    var maxIndImpact = Math.Max(1m, Model.IndustryContributions.Select(x => Math.Abs(x.Contribution)).DefaultIfEmpty(1m).Max());
    var maxEntImpact = Math.Max(1m, Model.EnterpriseImpact.Select(x => Math.Abs(x.Contribution)).DefaultIfEmpty(1m).Max());
    var unitName = Model.Filters.Metric == "industrial" ? "Tỷ đồng" : "1.000 USD";
}

@section Title { @ViewBag.Title }

@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}

<div class="management-dashboard">
    @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Analysis", Filters = Model.Filters })
    
    <div class="dashboard-heading">
        <div>
            <h1 id="dashboard-content" tabindex="-1">Phân tích chỉ tiêu: @Model.MetricLabel</h1>
            <p>Nhóm theo dõi đã phân loại <span class="breadcrumb-separator">&rsaquo;</span> Khu vực kinh tế <span class="breadcrumb-separator">&rsaquo;</span> Ngành <span class="breadcrumb-separator">&rsaquo;</span> Doanh nghiệp <span class="scope-badge">Chỉ dựa trên dữ liệu đã có</span></p>
        </div>
        <span class="dashboard-updated"><i class="fa fa-clock-o" aria-hidden="true"></i> Kỳ báo cáo: @Model.Filters.Month.ToString("00")/@Model.Filters.Year</span>
    </div>

    @Html.Partial("_DashboardFilters", Model.FilterOptions)

    <div class="row analysis-kpis">
        <div class="col-xs-6 col-md-3">
            <article class="dashboard-kpi kpi-blue">
                <div class="kpi-label">@Model.MetricLabel hiện tại</div>
                <div class="kpi-value">@Model.CurrentValue</div>
                <div class="kpi-note">Tháng @Model.Filters.Month.ToString("00")/@Model.Filters.Year &middot; @unitName</div>
            </article>
        </div>
        <div class="col-xs-6 col-md-3">
            <article class="dashboard-kpi kpi-green">
                <div class="kpi-label">So với tháng trước</div>
                <div class="kpi-value">@(Model.Mom.HasValue ? String.Format("{0:+0.0;-0.0;0.0}%", Model.Mom.Value) : "—")</div>
                <div class="kpi-note">@(Model.Mom.HasValue ? "Cùng tập doanh nghiệp" : "Chưa đủ dữ liệu đối chiếu")</div>
            </article>
        </div>
        <div class="col-xs-6 col-md-3">
            <article class="dashboard-kpi kpi-blue">
                <div class="kpi-label">So với cùng kỳ năm trước</div>
                <div class="kpi-value">@(Model.Yoy.HasValue ? String.Format("{0:+0.0;-0.0;0.0}%", Model.Yoy.Value) : "—")</div>
                <div class="kpi-note">@(Model.Yoy.HasValue ? "Cùng tập doanh nghiệp" : "Chưa đủ dữ liệu đối chiếu")</div>
            </article>
        </div>
        <div class="col-xs-6 col-md-3">
            <article class="dashboard-kpi kpi-slate">
                <div class="kpi-label">Lũy kế từ đầu năm</div>
                <div class="kpi-value">@Model.YtdValue</div>
                <div class="kpi-note">Cộng dồn các tháng đã báo cáo</div>
            </article>
        </div>
    </div>

    <div class="analysis-flow" aria-label="Các cấp phân tích">
        <span class="flow-step active"><i class="fa fa-folder-open-o" aria-hidden="true"></i> Nhóm theo dõi</span>
        <i class="fa fa-angle-right" aria-hidden="true"></i>
        <span class="flow-step"><i class="fa fa-building-o" aria-hidden="true"></i> Khu vực kinh tế</span>
        <i class="fa fa-angle-right" aria-hidden="true"></i>
        <span class="flow-step"><i class="fa fa-industry" aria-hidden="true"></i> Ngành chính</span>
        <i class="fa fa-angle-right" aria-hidden="true"></i>
        <span class="flow-step"><i class="fa fa-briefcase" aria-hidden="true"></i> Doanh nghiệp</span>
    </div>

    <div class="row dashboard-row">
        <div class="col-md-5">
            <section class="dashboard-panel sector-detail-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Đóng góp theo khu vực kinh tế</h2>
                        <p>Tỷ trọng @Model.MetricLabel trong giá trị đã báo cáo</p>
                    </div>
                </header>
                @if (Model.SectorContributions.Count == 0)
                {
                    <p class="dashboard-empty">Chưa có giá trị dương để phân tích.</p>
                }
                @foreach (var sector in Model.SectorContributions)
                {
                    var share = Model.Filters.Metric == "industrial" ? sector.GtsXcnShare : Model.Filters.Metric == "import" ? sector.ImportShare : sector.ExportShare;
                    <div class="horizontal-share">
                        <div class="horizontal-share-heading">
                            <strong>@sector.Name</strong>
                            <span>@share%</span>
                        </div>
                        <div class="ranked-bar-track">
                            <span class="ranked-bar sector-share" style="width:@share.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
                        </div>
                    </div>
                }
            </section>
        </div>
        <div class="col-md-7">
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Đóng góp theo ngành</h2>
                        <p>Thay đổi tuyệt đối so với tháng trước &middot; @unitName</p>
                    </div>
                </header>
                @if (Model.IndustryContributions.Count == 0)
                {
                    <p class="dashboard-empty">Chưa có tháng đối chiếu theo ngành.</p>
                }
                @foreach (var item in Model.IndustryContributions)
                {
                    <div class="compact-impact-row">
                        <span title="@item.Name">@item.Name</span>
                        <div class="ranked-bar-track">
                            <span class="ranked-bar @(item.Contribution < 0 ? "negative" : "positive")" 
                                  style="width:@((Math.Abs(item.Contribution) * 100m / maxIndImpact).ToString(System.Globalization.CultureInfo.InvariantCulture))%" 
                                  title="Kỳ trước: @item.PreviousValue; kỳ này: @item.CurrentValue; tỷ trọng thay đổi: @(item.ContributionShare.HasValue ? item.ContributionShare.Value.ToString("0.##") + "%" : "không xác định")"></span>
                        </div>
                        <strong class="@(item.Contribution < 0 ? "text-negative" : "text-positive")">
                            @String.Format("{0:+0.##;-0.##;0}", item.Contribution)
                        </strong>
                    </div>
                }
            </section>
        </div>
    </div>

    <div class="row dashboard-row">
        <div class="col-md-7">
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Doanh nghiệp tác động lớn</h2>
                        <p>Thay đổi tuyệt đối so với tháng trước &middot; @unitName</p>
                    </div>
                </header>
                @if (Model.EnterpriseImpact.Count == 0)
                {
                    <p class="dashboard-empty">Chưa có doanh nghiệp với hai tháng dữ liệu.</p>
                }
                @foreach (var item in Model.EnterpriseImpact)
                {
                    <div class="impact-enterprise-row">
                        <div class="ranked-copy">
                            <strong>@item.Name</strong>
                            <small>@item.Industry &middot; @item.PreviousValue &rarr; @item.CurrentValue &middot; @(item.ContributionShare.HasValue ? item.ContributionShare.Value.ToString("0.##") + "% biến động chung" : "chưa xác định tỷ trọng")</small>
                        </div>
                        <div class="ranked-bar-track">
                            <span class="ranked-bar @(item.Contribution < 0 ? "negative" : "positive")" 
                                  style="width:@((Math.Abs(item.Contribution) * 100m / maxEntImpact).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                        </div>
                        <strong class="@(item.Contribution < 0 ? "text-negative" : "text-positive")">
                            @String.Format("{0:+0.0;-0.0;0.0}", item.Contribution)
                        </strong>
                    </div>
                }
            </section>
        </div>
        <div class="col-md-5">
            @Html.Partial("_ReportedReasons", Model.Reasons)
        </div>
    </div>

    <div class="row dashboard-row">
        <div class="col-xs-12">
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Bảng tổng hợp chỉ tiêu theo kỳ</h2>
                        <p>Đối chiếu toàn diện số liệu báo cáo, mức tăng trưởng và lũy kế</p>
                    </div>
                </header>
                <div class="table-responsive">
                    <table class="table table-enterprise table-hover">
                        <thead>
                            <tr>
                                <th>Chỉ tiêu theo dõi</th>
                                <th>Đơn vị tính</th>
                                <th class="num-col">Kỳ hiện tại (@Model.Filters.Month.ToString("00")/@Model.Filters.Year)</th>
                                <th class="num-col">So với tháng trước</th>
                                <th class="num-col">So cùng kỳ năm trước</th>
                                <th class="num-col">Lũy kế từ đầu năm</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>@Model.MetricLabel</strong></td>
                                <td><span class="badge-tone tone-slate">@unitName</span></td>
                                <td class="num-col"><strong>@Model.CurrentValue</strong></td>
                                <td class="num-col">
                                    @if (Model.Mom.HasValue)
                                    {
                                        <span class="@(Model.Mom.Value >= 0 ? "text-positive" : "text-negative")">
                                            <strong>@String.Format("{0:+0.0;-0.0;0.0}%", Model.Mom.Value)</strong>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa đủ dữ liệu</span>
                                    }
                                </td>
                                <td class="num-col">
                                    @if (Model.Yoy.HasValue)
                                    {
                                        <span class="@(Model.Yoy.Value >= 0 ? "text-positive" : "text-negative")">
                                            <strong>@String.Format("{0:+0.0;-0.0;0.0}%", Model.Yoy.Value)</strong>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa đủ dữ liệu</span>
                                    }
                                </td>
                                <td class="num-col">
                                    <strong>@Model.YtdValue</strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>

@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}

@model CenIT.ReportTourism.Models.Report.DashboardModel

<section>
    <div class="box box-info">
        <div class="col-md-12">
            <h3 class="box-title">
                <i class="fa fa-dashboard"></i>&nbsp;THỐNG KÊ THÁNG <span class="text-danger" id="forMonth">@Model.ForMonth.GetValueOrDefault(DateTime.Now).ToString("MM/yyyy")</span>
                <a href="javascript:void(0)" id="SelectMonth"><i class="fa fa-calendar fa-lg"></i></a>
            </h3>
            <hr />
        </div>

        <div class="row">
            <div class="col-md-4 col-xs-8">
                <div class="small-box bg-primary" data-intro="Thống kê số lượng báo cáo đã thực hiện trong tháng @Model.ForMonth.GetValueOrDefault(DateTime.Now).ToString("MM/yyyy")">
                    <div class="inner">
                        <h3>@Model.ListBaocaoCacThang.FirstOrDefault().SoLuong</h3>
                        <p>Báo cáo đã thực hiện </p>
                    </div>
                    <div class="icon">
                        <i class="fa fa-ticket"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-xs-8">
                <div class="small-box bg-teal" data-intro="Thống kê danh sách doanh nghiệp trễ hạn báo cáo trong tháng @Model.ForMonth.GetValueOrDefault(DateTime.Now).ToString("MM/yyyy")">
                    <div class="inner">
                        <h3>@Model.ListBaocaoTre.FirstOrDefault().SoLuongBaoCaoTre</h3>
                        <p>Doanh nghiệp trễ hạn </p>
                    </div>
                    <div class="icon">
                        <i class="fa fa-money"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-xs-8">
                <div class="small-box bg-purple" data-intro="Thống kê danh sách doanh nghiệp chưa nộp báo cáo trong tháng @Model.ForMonth.GetValueOrDefault(DateTime.Now).ToString("MM/yyyy")">
                    <div class="inner">
                        <h3>@Model.ListBaocaoChuaNop.FirstOrDefault().SoLuongBaoCaoChuaNop</h3>
                        <p>Doanh nghiệp chưa nộp báo cáo</p>
                    </div>
                    <div class="icon">
                        <i class="fa fa-user-secret"></i>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title"><i class="fa fa-flag-o"></i>&nbsp;Doanh nghiệp theo từng lĩnh vực</h3>

                        <div class="box-tools pull-right">
                            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                                <i class="fa fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-box-tool" data-widget="remove">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <div class="box-body">
                        <div class="col-sm-2 col-xs-6">
                            <div class="description-block border-right" data-intro="Doanh nghiệp lĩnh vực lưu trú">
                                <h5 class="description-header text-maroon">@($"{@Model.ListThongkedoanhnghiep.FirstOrDefault().DN_Luutru}")</h5>
                                <span class="description-text text-bold">Lĩnh vực Lưu trú</span>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-sm-2 col-xs-6">
                            <div class="description-block border-right" data-intro="Doanh nghiệp lĩnh vực lưu trú Lữ hành">
                                <h5 class="description-header text-orange">@($"{@Model.ListThongkedoanhnghiep.FirstOrDefault().DN_PhucVuLuHanh}")</h5>
                                <span class="description-text text-bold">Lĩnh vực Lữ hành</span>
                            </div>
                        </div>
                        <div class="col-sm-2 col-xs-6">
                            <div class="description-block border-right" data-intro="Doanh nghiệp Lĩnh vực Vận chuyển khách du lịch">

                                <h5 class="description-header text-navy">@($"{@Model.ListThongkedoanhnghiep.FirstOrDefault().DN_DiemDuLich}")</h5>
                                <span class="description-text text-bold">Lĩnh vực Vận chuyển khách du lịch</span>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-sm-2 col-xs-6">
                            <div class="description-block border-right" data-intro="Doanh nghiệp Lĩnh vực Khu/điểm du lịch">
                                <h5 class="description-header text-navy">@($"{@Model.ListThongkedoanhnghiep.FirstOrDefault().DN_KhuDiemDuLich}")</h5>
                                <span class="description-text text-bold">Lĩnh vực Khu/điểm du lịch</span>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-sm-2 col-xs-6">
                            <div class="description-block border-right" data-intro="Doanh nghiệp Lĩnh vực Phục vụ khách du lịch">
                                <h5 class="description-header text-navy">@($"{@Model.ListThongkedoanhnghiep.FirstOrDefault().DN_VanChuyen}")</h5>
                                <span class="description-text text-bold">Lĩnh vực Phục vụ khách du lịch</span>
                            </div>
                        </div>
                    </div>
                    </div>
                </div>
                    <hr />
                </div>
</section>

@model CenIT.ReportTourism.Models.Report.DashboardModel

@using System.Linq
<section class="dashboard-panel contribution-panel">
    <header class="panel-heading">
        <div><h2>Đóng góp theo ngành</h2><p>Thay đổi doanh thu công nghiệp so với tháng trước · Tỷ đồng</p></div>
        <a class="panel-link" href="@Url.Action("Analysis", "Dashboard", new { Model.Filters.Year, Model.Filters.Month, Model.Filters.AreaId, Model.Filters.EconomicSectorId, Model.Filters.IndustryId, Model.Filters.EnterpriseId, metric = "industrial" })">Phân tích <i class="fa fa-angle-right" aria-hidden="true"></i></a>
    </header>
    @if (!Model.IndustryContributions.Any()) { <p class="dashboard-empty">Chưa có tháng đối chiếu theo ngành.</p> }
    <div class="diverging-chart" aria-label="Đóng góp theo ngành, mức thay đổi so với tháng trước">
        @foreach (var industry in Model.IndustryContributions)
        {
            var width = Math.Min(100m, Math.Abs(industry.Contribution) * 8m);
            <div class="diverging-row">
                <div class="diverging-label">@industry.Name</div>
                <div class="diverging-track">
                    <span class="diverging-zero"></span>
                    <span class="diverging-bar @(industry.Contribution < 0 ? "negative" : "positive")" style="width:@width.ToString(System.Globalization.CultureInfo.InvariantCulture)%" data-direction="@(industry.Contribution < 0 ? "left" : "right")"></span>
                </div>
                <strong class="diverging-value @(industry.Contribution < 0 ? "text-negative" : "text-positive")">@String.Format("{0:+0.0;-0.0;0.0}", industry.Contribution)</strong>
            </div>
        }
    </div>
</section>

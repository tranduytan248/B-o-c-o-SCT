@model CenIT.ReportTourism.Models.Report.DashboardModel
@using System.Web.Mvc
@using TSFramework.App.Processors

@{
    ViewBag.Title = "Tổng quan sản xuất công nghiệp, xuất nhập khẩu";
}

@section Title { Tổng quan }

@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/morris/morris.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}

<div class="management-dashboard dashboard-overview-page" id="managementDashboard">
    @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Overview", Filters = Model.Filters })

    <div class="dashboard-heading" style="margin-bottom: 12px;">
        <div class="pull-left">
            <h1 id="dashboard-content" style="font-size: 22px; font-weight: bold; margin: 0 0 4px; color: #333;">
                <i class="fa fa-dashboard text-primary"></i> Tổng quan ngành Công Thương
            </h1>
            <p class="text-muted" style="margin: 0; font-size: 13px;">
                @Model.FilterSummary · Dữ liệu snapshot tổng hợp trong phạm vi theo dõi.
            </p>
        </div>
        <div class="pull-right hidden-xs text-right" style="padding-top: 5px;">
            <span class="label label-default" style="font-size: 12px; padding: 5px 8px;">
                <i class="fa fa-clock-o"></i> Kỳ báo cáo: @Model.Filters.Month.ToString("00")/@Model.Filters.Year
            </span>
        </div>
        <div class="clearfix"></div>
    </div>

    @Html.Partial("_DashboardFilters", Model.FilterOptions)

    <!-- ROW 1: 4 KPI CARDS -->
    @Html.Partial("_StatisticEnterprise", Model)

    <!-- ROW 2: 8 COLS TREND + 4 COLS SECTOR -->
    <div class="row">
        <div class="col-md-8 col-sm-12">
            @Html.Partial("_StatisticVisitor", Model)
        </div>
        <div class="col-md-4 col-sm-12">
            @Html.Partial("_StatisticTypeBusiness", Model)
        </div>
    </div>

    <!-- ROW 3: 6 COLS ENTERPRISE MOVEMENT + 6 COLS ALERTS -->
    <div class="row">
        <div class="col-md-6 col-sm-12">
            @Html.Partial("_EnterpriseMovement", Model)
        </div>
        <div class="col-md-6 col-sm-12">
            @Html.Partial("_DashboardAlerts", Model)
        </div>
    </div>
</div>

@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/morris/raphael-min.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/morris/morris.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}

@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Report.ReportDataImportModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Upload"), $"{AppProcessor.Messagor.GetMessage("ReportDataImport_Title")} tháng {DateTime.Now:MM/yyyy}");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    <link href="~/Contents/Modules/Report/plugins/Import/_Import.css" rel="stylesheet"/>

    @using (Html.BeginForm("UploadData", "Import", new { area = "Report" }, FormMethod.Post, new { encType = "multipart/form-data", id = "ImportData", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ImportView")
        </div>
    }
    <script type="text/javascript">
        $('form#ImportData').ajaxForm({
            success: function(response) {
                if (response.status != undefined) {
                    if (!response.status && response.errorCode == 1) {
                        eval(response.message);
                        response.status = undefined;
                    } else {
                        $("#ModalContent #modal_ImportData").modal("hide");
                        $("#ModalContent #modal_ImportData").on('hidden.bs.modal',
                            function() {
                                if (response.status != undefined) {
                                    eval(response.message);
                                    _tableDataImport.ajax.reload(null, true);
                                    $("#ActionArea").load("/Report/Import/ViewAction");
                                    response.status = undefined;
                                }
                            });
                    }
                } else {
                    if ($(response).hasClass("modal-body")) {
                        $("#ModalContent #modal_ImportData").modal("hide");
                        $("#ModalContent #modal_ImportData").on('hidden.bs.modal',
                            function() {
                                if ($(response).hasClass("modal-body")) {
                                    showModalWithContent(response, "ReviewData", 1024, null);
                                }
                            });
                    } else {
                        $("#ModalContent #modal_ImportData" + " #bodyForm").html(response);
                    }
                }
            }
        });
    </script>
}
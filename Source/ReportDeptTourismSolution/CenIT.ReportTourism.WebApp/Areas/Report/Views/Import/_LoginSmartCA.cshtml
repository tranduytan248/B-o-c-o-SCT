@using TSFramework.App.Processors
@model CenIT.ReportTourism.Modules.SysModule.Areas.Sys.Models.LoginSmartCAModel
@Html.AntiForgeryToken()
<div class="form-group has-feedback">
    <span class="fa fa-user-circle-o form-control-feedback"></span>
    @Html.TextBoxFor(model => model.UserName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Authorize_UserName") })
    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
</div>
<div class="form-group has-feedback">
    <span class="fa fa-lock form-control-feedback"></span>
    @Html.TextBoxFor(model => model.Password, new { type = "Password", @class = "form-control", placeholder = "*********" })
    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
</div>
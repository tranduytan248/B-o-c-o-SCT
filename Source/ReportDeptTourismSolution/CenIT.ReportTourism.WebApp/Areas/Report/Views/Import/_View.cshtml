@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.ReportDataImportViewModel
@{
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-database"></i>
}

@section FormBody{
    <div id="bodyForm">
        <table id="ViewDataImports" class="table table-bordered table-striped" width="100%">
            <thead>
            <tr>
                <th width="20%">Chỉ tiêu</th>
                <th width="3%">Đơn vị tính</th>
                <th width="3%">Mã số</th>
                <th width="13.3%">Kế hoạch năm báo cáo</th>
                <th width="13.3%">Thực hiện tháng trước</th>
                <th width="13.3%">Ước thực hiện tháng báo cáo</th>
            </tr>
            </thead>
        </table>
    </div>
    <script type="text/javascript">
        var enterpriseId = @Model.EnterpriseId;
        var forMonth = '@Model.ForMonth.Value.ToString("yyyy-MM-dd")';

    </script>
    <script src="@Url.Content("~/Areas/Report/Views/Import/ViewDataImport.js")"></script>
}


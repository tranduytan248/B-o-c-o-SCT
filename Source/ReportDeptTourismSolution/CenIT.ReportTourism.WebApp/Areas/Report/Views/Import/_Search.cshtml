@using TSFramework.App.Processors
@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.ReportDataImportSearchModel

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">@AppProcessor.Messagor.GetMessage("Condition_Title")</h3>
        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="box-body with-border">
        <div class="form-horizontal" id="SearchDataReport">
            <div class="form-group row">
                <div class="col-md-12">
                    @Html.LabelFor(model => model.ListEnterprises, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.ListEnterpriseId, new SelectList(Model.ListEnterprises, "Value", "Text"), "", new { multiple = true, @class = "col-md-12 form-control" })
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FromMonth, new { @class = "row col-md-12" })
                    <div class="col-md-6 row">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </div>
                            @Html.TextBoxFor(model => model.FromMonth, "{0:MM/yyyy}", new { @class = "col-md-12 form-control", placeholder = "MM/yyyy" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </div>
                            @Html.TextBoxFor(model => model.ToMonth, "{0:MM/yyyy}", new { @class = "col-md-12 form-control", placeholder = "MM/yyyy" })
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.ListTypeBusiness, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.ListTypeBusinessId, new SelectList(Model.ListTypeBusiness, "Value", "Text"), "", new { multiple = true, @class = "col-md-12 form-control" })
                </div>
            </div>
        </div>
        <div class="box-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableDataImport.ajax.reload(null, true);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>
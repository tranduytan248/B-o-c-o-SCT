@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.ReportViewModel

@{
    ViewBag.Title = Model.ReportName;
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormBody{

    <style type="text/css">
        .modal-dialog-full {
            height: 100%;
            margin: 0;
            padding: 0;
            width: 100%;
        }

        .modal-content-full {
            border-radius: 0;
            height: auto;
            min-height: 100%;
        }
    </style>

    @using (Ajax.BeginForm("RenderReport", "Report", new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Report_OnProcessSuccess(data, 'RenderReport')",
        OnBegin = "$('#loader').addClass('show pageload-loading').css('display', 'inherit');"
    }, new { @class = "form-horizontal", id = "Reports" }))
    {
        <div id="bodyForm">
            @Html.Partial(Model.ViewName)
        </div>
    }
    <script type="text/javascript">
        function Report_OnProcessSuccess(response, formId) {
            showModalWithContent(response, formId, undefined, "Reports");
            $("#ModalContent #modal_" + formId).on("shown.bs.modal",
                function() {
                    $("#loader").addClass("show pageload-loading").css("display", "inherit");
                });
        }
    </script>

}

@section SubmitControl{
    <button type="submit" id="btnView" class="btn btn-primary"><i class="fa fa-save"></i>&nbsp;Xem</button>
}
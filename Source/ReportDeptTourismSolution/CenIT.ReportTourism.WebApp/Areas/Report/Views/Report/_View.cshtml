@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.ReportDataImportViewModel
@{
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-users"></i> 
}
@section FormBody{
    <div id="bodyForm">
        <div class="row">
            <div class="col-md-12 table-responsive">
                <table id="ViewDataImports" class="table table-bordered table-striped" width="120%">
                    <thead>
                        <tr>
                            @*<th>@AppProcessor.Messagor.GetMessage("Column_No")</th>*@
                            <th>Chỉ tiêu</th>
                            <th>Đơn vị tính</th>
                            <th>Mã số</th>
                            <th>Số thực hiện kỳ trước</th>
                            <th>Số thực hiện kỳ báo cáo</th>
                            <th>Luỹ kế từ đầu năm</th>
                            <th>Luỹ kế so với cùng kỳ năm trước</th>
                            @*<th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>*@
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        var enterpriseId = @Model.EnterpriseId;
        var forMonth = '@Model.ForMonth.Value.ToString("yyyy-MM-dd")';

    </script>
    <script src="@Url.Content("~/Areas/Report/Views/Import/ViewDataImport.js")"></script>
}

@section submitControl{

}
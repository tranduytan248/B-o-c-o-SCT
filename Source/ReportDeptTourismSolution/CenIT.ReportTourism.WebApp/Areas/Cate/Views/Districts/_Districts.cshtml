@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateDistrictModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.DistrictId)
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@{
    if (Model.DistrictId > 0)
    {
        <div class="form-group">
            @Html.TitleFor(model => model.ProvinceId, new { @class = "control-label col-md-4" })
            <div class="col-md-8">
                @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), "Tỉnh/Thành phố", new { @class = "form-control chosen-select mytheme-short-text" })
                @Html.HiddenFor(model => model.ProvinceId)
            </div>
        </div>
    }
    else
    {
        <div class="form-group">
            @Html.TitleFor(model => model.ProvinceId, new { @class = "control-label col-md-4" })
            <div class="col-md-8">
                @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), "Tỉnh/Thành phố", new { @class = "form-control chosen-select mytheme-short-text" })
                @Html.HiddenFor(model => model.ProvinceId)
                @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
            </div>
        </div>
    }
}
@{
    if (Model.DistrictId > 0)
    {
        <div class="form-group">
            @Html.TitleFor(model => model.DistrictCode, new { @class = "control-label col-md-4" })
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.DistrictCode, new { @class = "mytheme-short-text", @readonly = "readonly" })

            </div>
        </div>
    }
    else
    {
        <div class="form-group" style="display: none">
            @Html.TitleFor(model => model.DistrictCode, new { @class = "control-label col-md-4" })
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.DistrictCode, new { @class = "mytheme-short-text" })

            </div>
        </div>
    }
}
<div class="form-group">
    @Html.TitleFor(model => model.DistrictName, new { @class = "control-label col-md-4" })
    <div class="col-md-8">
        @Html.TextBoxFor(model => model.DistrictName, new { @class = "col-md-8", placeholder = AppProcessor.Messagor.GetMessage("District_Label_Name") })
        @Html.ValidationMessageFor(model => model.DistrictName, "", new { @class = "text-danger" })
    </div>
</div>
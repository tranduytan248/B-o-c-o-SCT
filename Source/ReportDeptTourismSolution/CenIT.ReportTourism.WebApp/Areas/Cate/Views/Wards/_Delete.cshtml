@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateWardModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("_Ward_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Wards", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "App_OnProcessSuccess(data, 'Delete')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.WardId)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
<!DOCTYPE html>
<html style="height: auto;" lang="vi">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="description" content="@ViewBag.Description"/>
    <link type="image/x-icon" rel="shortcut icon" href="~/Contents/imgs/ico-logo-vnpt.ico"/>

    <title>@ViewBag.Title</title>

    <!-- Bootstrap 3.3.6 -->
    <link rel="stylesheet" href="~/Contents/plugins/bootstrap/css/bootstrap.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/Contents/plugins/font-awesome-4.7.0/css/font-awesome.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="~/Contents/plugins/ionicons/ionicons.min.css">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
        <script src="~/Contents/plugins/html5shiv/html5shiv.min.js"></script>
        <script src="~/Contents/plugins/Respond/respond.min.js"></script>
    <![endif]-->
    <!-- inline styles related to this page -->
    <!--widget-->
    <link href="~/Contents/plugins/widget/widget.css" rel="stylesheet"/>
    <!--plugin vegas-->
    <link href="~/Contents/plugins/vegas/vegas.css" rel="stylesheet"/>
    <!--plugin animate-->
    <link href="~/Contents/css/animate.css" rel="stylesheet"/>
    <!--select2-->
    <link href="~/Contents/plugins/select2.4.0.3/select2.min.css" rel="stylesheet" async/>
    @*<link href="~/Contents/plugins/select2/themes/select2-bootstrap4.css" rel="stylesheet" />*@
    <!--chosen-->
    @*<link href="~/Contents/plugins/chosen/chosen.min.css" rel="stylesheet" async/>*@
    @*<link href="~/Contents/plugins/chosen/chosen.custom.css" rel="stylesheet" async/>*@
    <!--toastr-->
    <link href="~/Contents/plugins/toastr/toastr.css" rel="stylesheet" async/>
    <!-- Notify -->
    <link href="~/Contents/plugins/notify/notify.css" rel="stylesheet" async/>
    <!-- Loader -->
    <link href="~/Contents/css/loader.css" rel="stylesheet" async/>
    <!-- Iconpicker -->
    <link href="~/Contents/plugins/iconpicker/bootstrap-iconpicker.css" rel="stylesheet"/>
    <!-- Datepicker -->
    <link href="~/Contents/plugins/datepicker/datepicker3.css" rel="stylesheet" async/>
    <!-- DateRangePicker -->
    <link href="~/Contents/plugins/daterangepicker/daterangepicker.css" rel="stylesheet" async/>
    <!-- Datatable -->
    <link href="~/Contents/plugins/datatables/dataTables.bootstrap.css" rel="stylesheet" async/>
    <link href="~/Contents/plugins/datatables/select.dataTables.min.css" rel="stylesheet" async/>
    <link href="~/Contents/plugins/datatables/dataTables.checkboxes.css" rel="stylesheet" async/>
    <link href="~/Contents/plugins/datatables/extensions/ColVis/css/dataTables.colVis.css" rel="stylesheet" async/>

    <!-- Theme style -->
    <link rel="stylesheet" href="~/Contents/plugins/AdminLTE-2.3.11/css/AdminLTE.css">
    <!-- AdminLTE Skins. Choose a skin from the css/skins
    folder instead of downloading all of them to reduce the load. -->
    <link rel="stylesheet" href="~/Contents/plugins/AdminLTE-2.3.11/css/skins/_all-skins.css">
    <link rel="stylesheet" href="~/Contents/plugins/AdminLTE-2.3.11/css/skins/skin-vnpt.css">

    <!---------------------------------------------------------------------------------------------------->
    <!--plugin TSFramework-->
    <link href="~/Contents/plugins/TSFramework/TSFramework.css" rel="stylesheet"/>


    @RenderSection("HeadCss", false)
    @RenderSection("HeadJs", false)

</head>
@RenderBody()
</html>
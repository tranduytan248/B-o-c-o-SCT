@using TSFramework.App.Processors
@model List<CenIT.ReportTourism.Models.Sys.SysModuleModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = AppProcessor.Messagor.GetMessage("App_Title");
}
<div class="container">
    <div class="col-md-12 text-center">
        <a href="@Url.Action("Index", "Home")">
            <img src="~/Contents/imgs/main-logo-vnpt.png"/>
        </a>
    </div>
    <p class="clearfix"></p>
    <hr/>
    <div class="col-md-12">
        <div class="col-md-3 text-center">
            <a href="@Url.Action("Index", "Layout")">
                <i class="fa fa-eye-slash fa-4" aria-hidden="true"></i>
                <p>Layout</p>
            </a>
        </div>
        @{
            if (Model != null)
            {
                foreach (var module in Model)
                {
                    var urlHref = Url.Action("Index", module.MainController, new {area = module.ModuleName});
                    if (!string.IsNullOrEmpty(urlHref))
                    {
                        <div class="col-md-3 text-center">
                            <a href="@urlHref">
                                <i class="fa @module.Icon fa-4" aria-hidden="true"></i>
                                <p>@module.Description</p>
                            </a>
                        </div>
                    }
                }
            }
        }
        @*<div class="col-md-3 text-center">
            <a href="/">
                <i class="fa fa-calendar fa-4" aria-hidden="true"></i>
                <p>Home</p>
            </a>
        </div>
        <div class="col-md-3 text-center">
            <a href="/">
                <i class="fa fa-cog fa-4" aria-hidden="true"></i>
                <p>Config</p>
            </a>
        </div>
        <div class="col-md-3 text-center">
            <a href="/">
                <i class="fa fa-file fa-4" aria-hidden="true"></i>
                <p>Files</p>
            </a>
        </div>
        <div class="col-md-3 text-center">
            <a href="@Url.Action("Index", "User", new {area = "Sys"})">
                <i class="fa fa-gears fa-4" aria-hidden="true"></i>
                <p>Sys</p>
            </a>
        </div>*@
    </div>
</div>
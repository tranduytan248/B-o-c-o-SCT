@*@model CenIT.ReportTourism.Models.Sys.SysUserModel*@
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "";
}
@using (Ajax.BeginForm("ForgotPassword", "Account", new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "Forgot_OnProcessSuccess(data, 'ForgotPassword')"
}, new {@class = "form-horizontal", id = "ForgotForm"}))
{
    <div class="modal-body modal-danger">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        <div class="form-body">
            <div class="form-group" style="text-align: center;">
                <b style="color: dodgerblue; font-size: 30px;">QUÊN MẬT KHẨU</b>
            </div>
            <div class="form-group" style="text-align: center;">
                <blockquote>
                    <p>Vui lòng nhập thông tin email liên kết với tài khoản để nhận hướng dẫn.</p>
                </blockquote>
            </div>
            <div id="bodyForm">
                @Html.Partial("_ForgotView")
            </div>

            <div class="form-group" style="text-align: center;">
                <button type="button" id="btnXacNhan" class="btn btn-primary" style="width: 200px;">Xác nhận</button>
            </div>
        </div>
    </div>
}
<script type="text/javascript">
    $('#btnXacNhan').click(function(event) {
        $("#ForgotForm").submit();
    });

    $('form input').keydown(function(e) {
        if (e.keyCode == 13) {
            e.preventDefault();
            return false;
        }
    });

    function Forgot_OnProcessSuccess(response, formId) {
        if (response.status != undefined && response.status === true) {
            $("#ModalContent #modal_" + formId).modal("hide");
            $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                function() {
                    if (response.status != undefined) {
                        eval(response.message);
                        response.status = undefined;
                    }
                });
        } else if (response.status != undefined && response.status === false) {
            eval(response.message);
            response.status = undefined;
        } else {
            $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
        }
    }
</script>
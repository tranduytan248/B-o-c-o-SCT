@using TSFramework.App.Processors
@model CenIT.ReportTourism.WebApp.Models.FileInfoModel

@{
    ViewBag.Title = "Xoá file log";
    Layout = "";
}
@using (Ajax.BeginForm("DeleteOldFile", "SysLog", new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "SysLog_OnProcessSuccess(data, 'DeleteOldFile')"
}, new {@class = "form-horizontal"}))
{
    <div class="modal-header bg-red">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title" id="modal-label"><i class="fa fa-trash-o"></i>&nbsp;@ViewBag.Title</h4>
    </div>
    <div class="modal-body">
        <div class="form-body" id="bodyForm">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="control-label col-md-3">Xoá tất cả file log</label>
                <div class="col-md-2">
                    @Html.TextBox("MonthAgo", 0, new {@class = "col-lg-10", placeholder = "Tháng", type = "number", min = "0"})
                </div>
                <label class="text-left control-label col-md-3">tháng về trước</label>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" id="btnDelete" class="btn btn-danger">
            @AppProcessor.Messagor.GetMessage("Button_Delete")
        </button>
        <button type="button" class="btn btn-primary" data-dismiss="modal">
            @AppProcessor.Messagor.GetMessage("Button_Cancel")
        </button>
    </div>
}
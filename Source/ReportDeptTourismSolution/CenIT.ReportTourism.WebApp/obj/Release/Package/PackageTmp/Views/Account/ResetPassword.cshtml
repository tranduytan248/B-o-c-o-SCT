@using TSFramework.App.Processors
@model CenIT.ReportTourism.WebApp.Models.ResetPasswordModel

@{
    var skinName = ViewBag.ActivatedLayout;
    skinName = skinName ?? "_Default";
    var skinView = $"~/Views/Skin/{skinName}/{skinName}.cshtml";
    if (!File.Exists(Server.MapPath(skinView)))
    {
        skinView = "~/Views/Skin/_Default/_Default.cshtml";
    }
    Layout = skinView;
    //Layout = "~/Views/Skin/_Green/_Green.cshtml";
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Authorize_Reset_Password");
}

@section HeadCss{
    <link href="~/Contents/plugins/login/style.css" rel="stylesheet" />
    <style type="text/css">
        .login-box-body, .register-box-body {
            background: inherit;
        }

        .layout-boxed {
            background-image: url('/Contents/imgs/login/bg-login.jpg');
            background-repeat: no-repeat;
            background-size: cover;
        }

        .logo-img img {
            width: 30%;
        }

        .toolbar {
            margin: 10px 0;
        }

        .login-box-body {
            padding: 20px 20px 10px 20px;
        }

            .login-box-body h2 {
                margin-top: 10px;
            }

        .widget-box {
            -moz-transform: scale(0, 1) translate(-150px);
            -ms-transform: scale(0, 1) translate(-150px);
            -o-transform: scale(0, 1) translate(-150px);
            -webkit-transform: scale(0, 1) translate(-150px);
            background-color: rgba(255, 255, 255, 0.44);
            border-bottom: none;
            box-shadow: none;
            margin: 5% auto 0;
            position: fixed;
            transform: scale(0, 1) translate(-150px);
            visibility: hidden;
            z-index: -5;
        }

            .widget-box.visible {
                -moz-transform: scale(1, 1) translate(0);
                -moz-transition: -moz-transform 0.3s ease;
                -ms-transform: scale(1, 1) translate(0);
                -o-transform: scale(1, 1) translate(0);
                -o-transition: -o-transform 0.2s ease;
                -webkit-transform: scale(1, 1) translate(0);
                -webkit-transition: -webkit-transform 0.3s ease;
                position: relative;
                transform: scale(1, 1) translate(0);
                transition: transform .3s ease;
                visibility: visible;
                z-index: auto;
            }

        .control-sidebar-bg,
        .control-sidebar {
            padding-top: 0;
            right: -480px;
            width: 480px;
        }

        .box { /*background: transparent;*/
        }

        .logo-img hr {
            border-color: #0073b7;
            margin-bottom: 0;
        }
    </style>

}

<div class="signin login-box widget-box visible">
    <div class="logo-img text-center">
        <a href="/">
            <img alt="" src="~/Contents/imgs/sodulich-logo.png" />
            <h2 class="box-title text-blue" style="font-size: 150%; font-weight: 600">
                HỆ THỐNG BÁO CÁO DU LỊCH
            </h2>
        </a>
        <hr style="border-color: #0073b7; margin-bottom: 0;">
    </div>
    <!-- /.login-logo -->
    <div class="login-box-body">
        @using (Html.BeginForm("ResetPassword", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "", id = "LoginForm", role = "form" }))
        {
            @Html.AntiForgeryToken()
            <div id="ContentResetPassword">
                @Html.Partial("_ResetPassword")
            </div>
            <div class="row">
                <div class="col-xs-12">
                    @{
                        if (Model.IsPermit)
                        {
                            <button type="submit" class="btn btn-primary btn-flat pull-left">
                                <i class="fa fa-save"></i>
                                Cập nhật
                            </button>
                        }
                        else
                        {
                            <div class="toolbar clearfix">
                                <div class="pull-left">
                                    <a href="@Url.Action("Login")">
                                        <i class="fa fa-arrow-left"></i>
                                        Đăng nhập
                                    </a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="social-auth-links text-center">
                <hr style="border-color: #0073b7" />
                <div class="logo_footer">
                    <a href="https://vnpt.com.vn/" target="_blank">
                        <img width="75%" src="/Contents/imgs/logo_footer.png">
                    </a>
                </div>
            </div>
                        }
        <!-- /.login-box-body -->

    </div>

</div>

<!-- /.login-box -->

@section CustomJS
{
    <script type="text/javascript">
        $("body").removeAttr('class');
        $("body").addClass("hold-transition layout-boxed");

        $('form').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    eval(response.message);
                    response.status = undefined;
                    window.location = "@Url.Action("Login")";
                } else {
                    $("#LoginForm #ContentResetPassword" + " #bodyForm").html(response);
                }
            }
        });

        function _showPassword(inpt) {
            if ('password' == $(inpt).attr('type')) {
                $(inpt).prop('type', 'text');
            } else {
                $(inpt).prop('type', 'password');
            }
        }
    </script>

    <script src="@Url.Content("~/Views/Account/PasswordValid.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            var confirmPassValid = "#ConfirmPassword";
            $("#NewPassword").passwordValidation({ "confirmField": confirmPassValid, "minLength": 8 },
                function (element, valid, match, failedCases) {
                    $("span[data-valmsg-for='NewPassword']").empty();
                    $.each(failedCases,
                        function (idx, msg) {
                            $("span[data-valmsg-for='NewPassword']").append(' <p class="text-red">' + msg + "</p>");
                        });
                    if (valid) $(element).css("border", "1px solid #00a65a");
                    if (!valid) $(element).css("border", "1px solid #dd4b39");
                    if (valid && match) $(confirmPassValid).css("border", "1px solid #00a65a");
                    if (!valid || !match) $(confirmPassValid).css("border", "1px solid #dd4b39");
                });
        });
    </script>
}
@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Common_AccessDenied");
    //Layout = "~/Views/Shared/_Error.cshtml";
}
<section class="invoice" style="height: calc(70vh)">
    <div class="error-page">
        <h2 class="headline text-red">403</h2>
        <div class="error-content">
            <h3>
                <i class="fa fa-info text-light-blue"></i> @AppProcessor.Messagor.GetMessage("Common_AccessDenied")
            </h3>
            <p>
                @AppProcessor.Messagor.GetMessage("Common_AccessDenied_Message")
            </p>
            @Html.ActionLink(AppProcessor.Messagor.GetMessage("Button_Back"), "Index", "Home", new {}, new {@class = "btn btn-primary", lang = "en"})
        </div>
    </div>
</section>
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.TouristAttraction.CateTouristAttractionModel
@Html.AntiForgeryToken()

@using (Html.BeginForm("SaveInfo", "TouristAttraction", new { area = "" }, FormMethod.Post, new { encType = "multipart/form-data", id = "SaveInfo", @class = "form-horizontal" }))
{
    @Html.HiddenFor(model => model.EnterpriseId)

    <div class="box-body" id="bodyForm">
        <div class="form-group">
            @Html.TitleFor(model => model.ListTypeTourismActivitieIds, new { @class = "control-label col-md-3" })
            <div class="col-md-9">
                @Html.DropDownListFor(model => model.ListTypeTourismActivitieIds, new SelectList(Model.ListTypeTourismActivities, "Value", "Text"), new { @class = "col-md-10", multiple = true })
                @Html.ValidationMessageFor(model => model.ListTypeTourismActivitieIds, "", new { @class = "text-danger" })
            </div>
        </div>
        <hr/>
        <div class="form-group">
            @Html.TitleFor(model => model.Reason, new { @class = "control-label col-md-3" })
            <div class="col-md-9">
                @Html.TextAreaFor(model => model.Reason, new { rows = "3", @class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
                @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="box-footer">
        <button type="button" class="btn btn-primary pull-right" onclick="$('form#SaveInfo').submit();"><i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Save")</button>
    </div>
}

<script type="text/javascript">
    $('form#SaveInfo').ajaxForm({
        success: function(response) {
            if (response.status != undefined) {
                eval(response.message);
                $("#TouristAttractionInfo")
                    .load('@Url.Action("TouristAttractionInfo", new { enterpriseId = Model.EnterpriseId })');
                response.status = undefined;
            } else {
                $("#TouristAttractionInfo").html(response);
            }
        }
    });
    $(document).ready(function() {
        initSelects();
    });

    function initSelects() {

        //Join Member
        $('#bodyForm #ListTypeTourismActivitieIds').val(("@Model.TypeTourismActivities").split(','));
        $('#bodyForm #ListTypeTourismActivitieIds')
            .select2({ no_results_text: "@AppProcessor.Messagor.GetMessage("Common_NotFound")" }).change(
                function(item) {
                    var val = $('#bodyForm select[id$=ListTypeTourismActivitieIds] option:selected')
                        .map(function() { return this.value }).get().join(",");
                    $('#bodyForm input[type="hidden"][id$="TypeTourismActivities"]').val(val);
                });

    }

</script>
<!--Reference the autogenerated SignalR hub script. -->
<script src="~/signalr/hubs"></script>

<script type="text/javascript">

    var NotificationHubWrapper = function() {
        var self = this;
        var hub = null;
        var isStarted = false;
        var onNotifyCallback = function() {};

        self.start = function() {
            hub = $.connection.notificationHub;
            hub.client.onNotify = onNotifyCallback;
            return $.connection.hub.start()
                .done(function() { isStarted = true; });
        };

        $.connection.hub.error(function(error) {
            toastr.error(error.message);
        });

        self.stop = function() {
            isStarted = false;
            hub = null;
            return $.connection.notificationHub.stop();
        };


        self.onNotify = function(callback) {
            onNotifyCallback = callback;
            if (isStarted) {
                hub.client.onNotify = onNotifyCallback;
            }
        };
    };

    var notificationHub = new NotificationHubWrapper();

    $(document).ready(function() {
        notificationHub.onNotify(notifyMessage);
        notificationHub.start().done(function() {
        });
    });

    function notifyMessage(userName, message) {
        eval(message);
    }

</script>

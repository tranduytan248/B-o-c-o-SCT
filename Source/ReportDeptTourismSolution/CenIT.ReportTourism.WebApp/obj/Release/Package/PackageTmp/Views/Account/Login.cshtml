@using TSFramework.App.Processors
@model CenIT.ReportTourism.WebApp.Models.LoginModel

@{
    //var skinName = ConfigurationManager.AppSettings["WebAppSkin"];
    var skinName = ViewBag.ActivatedLayout;
    skinName = skinName ?? "_Default";
    var skinView = $"~/Views/Skin/{skinName}/{skinName}.cshtml";
    if (!File.Exists(Server.MapPath(skinView)))
    {
        skinView = "~/Views/Skin/_Default/_Default.cshtml";
    }
    Layout = skinView;
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Authorize_Login");
}

@section HeadCss{
    <link href="~/Contents/plugins/login/style.css" rel="stylesheet"/>
    <style type="text/css">
        .login-box-body, .register-box-body { background: inherit; }

        .layout-boxed {
            background-image: url('/Contents/imgs/login/bg-login.jpg');
            background-repeat: no-repeat;
            background-size: cover;
        }

        .logo-img img { width: 30%; }

        .toolbar { margin: 10px 0; }

        .login-box-body { padding: 20px 20px 10px 20px; }

        .login-box-body h2 { margin-top: 10px; }

        .widget-box {
            -moz-transform: scale(0, 1) translate(-150px);
            -ms-transform: scale(0, 1) translate(-150px);
            -o-transform: scale(0, 1) translate(-150px);
            -webkit-transform: scale(0, 1) translate(-150px);
            background-color: rgba(255, 255, 255, 0.44);
            border-bottom: none;
            box-shadow: none;
            margin: 5% auto 0;
            position: fixed;
            transform: scale(0, 1) translate(-150px);
            visibility: hidden;
            z-index: -5;
        }

        .widget-box.visible {
            -moz-transform: scale(1, 1) translate(0);
            -moz-transition: -moz-transform 0.3s ease;
            -ms-transform: scale(1, 1) translate(0);
            -o-transform: scale(1, 1) translate(0);
            -o-transition: -o-transform 0.2s ease;
            -webkit-transform: scale(1, 1) translate(0);
            -webkit-transition: -webkit-transform 0.3s ease;
            position: relative;
            transform: scale(1, 1) translate(0);
            transition: transform .3s ease;
            visibility: visible;
            z-index: auto;
        }

        .control-sidebar-bg,
        .control-sidebar {
            padding-top: 0;
            right: -480px;
            width: 480px;
        }

        .box { /*background: transparent;*/ }

        .logo-img hr {
            border-color: #0073b7;
            margin-bottom: 0;
        }
    </style>
}

<div class="signin login-box widget-box visible" id="LoginBox">
    <div class="logo-img text-center">
        <a href="/">
            <img alt="" src="~/Contents/imgs/sodulich-logo.png" />
            <h2 class="box-title text-blue" style="font-size: 150%; font-weight: 600">
                HỆ THỐNG BÁO CÁO DU LỊCH
            </h2>
        </a>
        <hr style="border-color: #0073b7; margin-bottom: 0;">
    </div>
    <!-- /.login-logo -->
    <div class="login-box-body">
        @using (Html.BeginForm("Login", "Account", new {returnUrl = ViewBag.ReturnUrl}, FormMethod.Post, new {@class = "", id = "LoginForm", role = "form"}))
        {
            <div class="form-group">
                <span class="text-center text-blue" style="font-size: large"><i class="fa fa-unlock-alt"></i> CHÀO MỪNG TRỞ LẠI</span>
            </div>

            <div id="ContentLogin">
                @Html.Partial("_Login")
            </div>

            <div class="row">
                <div class="col-xs-12 text-center">
                    <button type="submit" class="btn btn-primary btn-flat pull-left">
                        <i class="fa fa-key"></i>&nbsp;Đăng Nhập
                    </button>
                    @*<a class="btn bg-navy btn-flat" href="#" data-target="#SmartCA">
                        <i class="fa fa-code"></i>&nbsp;Ký số
                    </a>*@
                    <a class="btn btn-primary btn-flat pull-right" href="https://zalo.me/g/gmgksb682" target="_blank">
                        <i class="fa fa-weixin"></i>&nbsp;Hỗ trợ
                    </a>
                </div>
            </div>
            <hr/>
            <div class="toolbar clearfix">
                <div class="pull-right">
                    <a href="#" data-target="#FogotBox">
                        Quên mật khẩu
                        <i class="fa fa-arrow-right"></i>
                    </a>
                </div>
                <div class="pull-right" style="margin: 0 10%">
                    <a href="#" data-toggle="control-sidebar"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</a>
                </div>
                <div class="pull-left">
                    <a class="" data-modal="true" data-modal-id="Register" data-width="1024" href="@Url.Action("Register", "Account", new {area = ""})"><i class='fa fa-arrow-left'></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Register")</a>
                </div>
            </div>
        }
        <div class="social-auth-links text-center">
            <hr style="border-color: #0073b7"/>
            <div class="logo_footer">
                <a href="https://vnpt.com.vn/" target="_blank">
                    <img width="75%" src="/Contents/imgs/logo_footer.png">
                </a>
            </div>
        </div>
    </div>
    <!-- /.login-box-body -->
</div>
<!-- /.login-box -->

@Html.Partial("_ForgotBox")
<!-- /.forgot-box -->

@{
    Html.RenderAction("Search");
    Html.RenderAction("SmartCA");
}

@section CustomJS
{
    <script type="text/javascript">

        var accessToken = "";
        var btnLoginCA = document.createElement('a');
        $("body").removeAttr('class');
        $("body").addClass("hold-transition layout-boxed");
        jQuery(function($) {

            btnLoginCA.style.display = 'none';
            btnLoginCA.href = '@Url.Action("LoginSmartCA")';
            btnLoginCA.class = 'btn hidden';
            btnLoginCA.setAttribute('data-modal', 'true');
            btnLoginCA.setAttribute('data-modal-id', 'LoginSmartCA');

            $(document).on('click',
                'a[data-target]',
                function(e) {
                    e.preventDefault();
                    var target = $(this).data('target');
                    $('.widget-box.visible').removeClass('visible'); //hide others
                    $(target).addClass('visible'); //show target
                    if (target == "#SmartCA" && accessToken.length <= 0) {
                        document.body.appendChild(btnLoginCA);
                        btnLoginCA.click();
                    }
                });
        });

        $('form#LoginForm').ajaxForm({
            beforeSubmit: function(arr, $form, options) {
                $('form#LoginForm input, form#LoginForm button, form#LoginForm a').attr("disabled", true);
                return true;
            },
            success: function(response) {
                if (response.status != undefined) {
                    eval(response.message);
                    if (response.status) {
                        window.location = window.location.origin + response.returnUrl;
                    }
                    response.status = undefined;
                } else {
                    $("#LoginForm #ContentLogin").html(response);
                    $('form#LoginForm input, form#LoginForm button, form#LoginForm a').removeAttr("disabled");
                }
            }
        });

        $('form#ForgotForm').ajaxForm({
            success: function(response) {
                if (response.status != undefined) {
                    eval(response.message);
                    if (response.status) {
                        var delayInMilliseconds = 3000;
                        setTimeout(function() {
                                window.location.reload();
                            },
                            delayInMilliseconds);
                    }
                    response.status = undefined;
                } else {
                    $("#ForgotForm #ContentForgot").html(response);
                }
            }
        });
    </script>
}
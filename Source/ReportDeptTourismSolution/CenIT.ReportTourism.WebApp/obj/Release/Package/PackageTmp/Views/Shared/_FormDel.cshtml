@using TSFramework.App.Processors
<div class="modal-header bg-red">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title" id="modal-label">
        <i class="fa fa-trash-o"></i>&nbsp;@Html.Raw(ViewBag.Title)
    </h4>
</div>
<div class="modal-body">
    <div class="form-horizontal">
        @RenderSection("FormBody", true)
    </div>
</div>
<div class="modal-footer">
    <button type="submit" id="btnDelete" class="btn btn-danger">
        <i class="fa fa-check"></i>
        @AppProcessor.Messagor.GetMessage("Button_Confirm")
    </button>
    <button type="button" class="btn btn-primary" data-dismiss="modal">
        <i class="fa fa-close"></i>
        @AppProcessor.Messagor.GetMessage("Button_Cancel")
    </button>
</div>
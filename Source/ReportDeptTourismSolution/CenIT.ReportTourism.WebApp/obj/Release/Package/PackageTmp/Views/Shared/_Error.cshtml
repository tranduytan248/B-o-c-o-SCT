@using System.Configuration
@*@{
    Layout = "~/Views/Shared/_Main.cshtml";
}*@
@{
    var skinName = ConfigurationManager.AppSettings["WebAppSkin"];
    skinName = skinName ?? "_Default";
    var skinView = $"~/Views/Skin/{skinName}/{skinName}.cshtml";
    if (!File.Exists(Server.MapPath(skinView)))
    {
        skinView = "~/Views/Skin/_Default/_Default.cshtml";
    }
    Layout = skinView;
}

@section HeadJS{
    @RenderSection("HeadJS", false)
}

@section HeadCSS{
    @RenderSection("HeadCSS", false)
}

<div class="wrapper" id="main_layout" style="height: auto; overflow: hidden;">
    <aside class="main-sidebar mt0" id="tab_menu">
        <section class="sidebar">
            @*@{Html.RenderAction("Menu", "Home");}*@
        </section>
    </aside>

    <header class="main-header  hidden-md hidden-lg">
        <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button"
           style="color: #fff; padding: 10px 10px; position: absolute;">
            <span class="sr-only">Toggle navigation</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </a>
        <a href="/" class="logo" style="height: auto">
            <span class="logo-lg">
                <img src="~/Contents/imgs/logo-vnpt.png" height="auto" width="40%" alt="" style="display: block; margin: auto;"/>
            </span>
        </a>
    </header>

    <div class="content-wrapper" id="tab_content">
        <section class="content">
            @RenderBody()
        </section>
    </div>
    <div class="control-sidebar-bg"></div>
</div>

@section CustomJS
{
    @RenderSection("scripts", false)
}
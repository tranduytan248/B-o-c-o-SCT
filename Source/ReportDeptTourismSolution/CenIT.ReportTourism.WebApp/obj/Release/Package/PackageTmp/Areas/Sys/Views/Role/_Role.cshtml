@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysRoleModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.RoleId)

<div class="form-group">
    @Html.TitleFor(model => model.Name, new { @class = "control-label col-md-3" })
    <div class="col-md-9">
        @Html.TextBoxFor(model => model.Name, new { @class = "col-md-9", placeholder = AppProcessor.Messagor.GetMessage("Role_Label_Name") })
        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
    </div>
</div>
@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysRoleModel

@{
    ViewBag.Title = Html.Raw(string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Permission"), $"<b>[{Model.Name}]</b>"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-shield"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("Permission", "Role", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Role_OnProcessSuccess(data, 'PermissionRole')"
    }, new { @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_FunctionAction")
        </div>
    }
}
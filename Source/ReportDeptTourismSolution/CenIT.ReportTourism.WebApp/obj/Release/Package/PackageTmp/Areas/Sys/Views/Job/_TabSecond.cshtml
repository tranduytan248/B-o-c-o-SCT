<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronEverySecond" name="cronSecond">
            <label for="cronEverySecond">Every second</label>
        </div>
    </div>
</div>
<div class="form-group">
    <div class="col-md-1">
        <div class="radio col-md-12">
            <input type="radio" id="cronSecondIncrement" name="cronSecond">
            <label for="cronSecondIncrement">Every</label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronSecondIncrementIncrement" class="col-md-8">
            @{
                for (var idx = 1; idx <= 60; idx++)
                {
                    <option value="@idx">@idx</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="control-label"> second(s) starting at second </label>
    </div>
    <div class="col-md-2">
        <select id="cronSecondIncrementStart" class="col-md-8">
            @{
                for (var idx = 0; idx < 60; idx++)
                {
                    <option value="@idx">@(idx.ToString().PadLeft(2, '0'))</option>
                }
            }
        </select>
    </div>
</div>
<div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <input type="radio" id="cronSecondSpecific" checked="checked" name="cronSecond">
            <label for="cronSecondSpecific">
                Specific second (choose one or many)
            </label>
        </div>
    </div>
    <div class="col-md-1">
    </div>
    @{
        var isCheckSecond = false;
        for (var idx = 0; idx < 60; idx++)
        {
            if (idx % 10 == 0)
            {
                <div class="col-md-1"></div>
            }
            var eleId = $"cronSecond{idx}";

            <div class="col-md-1">
                <div class="checkbox">
                    @{
                        if (!isCheckSecond)
                        {
                            <input type="checkbox" id="@eleId" name="cronSecondSpecificSpecific" value="@idx"
                                   checked="checked">
                            isCheckSecond = true;
                        }
                        else
                        {
                            <input type="checkbox" id="@eleId" name="cronSecondSpecificSpecific" value="@idx">
                        }
                    }
                    <label for="@eleId">@(idx.ToString().PadLeft(2, '0'))</label>
                </div>
            </div>
            if (idx % 10 != 9)
            {
                continue;
            }
            <div class="col-md-1"></div>
        }
    }

    <div class="col-md-1">
    </div>
</div>
<div class="form-group">
    <div class="col-md-4">
        <div class="radio col-md-12">
            <input type="radio" id="cronSecondRange" name="cronSecond">
            <label for="cronSecondRange">
                Every second between second
            </label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronSecondRangeStart" class="col-md-8">
            @{
                for (var idx = 0; idx < 60; idx++)
                {
                    <option value="@idx">@(idx.ToString().PadLeft(2, '0'))</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="control-label"> and second </label>
    </div>
    <div class="col-md-2">
        <select id="cronSecondRangeEnd" class="col-md-8">
            @{
                for (var idx = 0; idx < 60; idx++)
                {
                    <option value="@idx">@(idx.ToString().PadLeft(2, '0'))</option>
                }
            }
        </select>
    </div>
</div>
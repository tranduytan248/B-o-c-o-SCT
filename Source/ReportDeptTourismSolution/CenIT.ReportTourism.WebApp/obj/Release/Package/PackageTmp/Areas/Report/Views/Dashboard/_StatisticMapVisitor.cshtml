@using Newtonsoft.Json
@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.StatisticMapVisitorViewModel

<!-- Map box -->
<div class="box no-footer no-border bg-light-blue-gradient">
    <div class="box-header">
        <!-- tools box -->
        <div class="pull-right box-tools">
            @*<button type="button" class="btn btn-primary btn-sm pull-right" data-widget="collapse" data-toggle="tooltip" title="Thu nhỏ">
                <i class="fa fa-minus"></i>
            </button>*@
        </div>
        <!-- /. tools -->

        <i class="fa fa-map-marker"></i>

        <h3 class="box-title">
            Bản đồ lượt Khách du lịch tháng @Model.OnMonth.ToString("MM/yyyy")
        </h3>
    </div>
    <div class="box-body">
        <div id="world-map" style="height: 250px; width: 100%;"></div>
    </div>
    <!-- /.box-body-->
    <div class="overlay hidden">
        <i class="fa fa-refresh fa-spin"></i>
    </div>
</div>
<!-- /.box -->
<!-- jvectormap -->
<script src="@Url.Content("~/Contents/plugins/jvectormap/jquery-jvectormap-1.2.2.min.js")"></script>
<script src="@Url.Content("~/Contents/plugins/jvectormap/jquery-jvectormap-world-mill-en.js")"></script>
<script type="text/javascript">
    $(function() {

        //jvectormap data
        @{ var dataStatistic = Model.DataStatistic.Select(d => new { d.NationalCode, d.TotalVisitor }).ToArray(); }
        var visitorsData = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(dataStatistic))');
        var arrVisitorsDatas = {};
        $.each(visitorsData,
            function(i, data) {
                arrVisitorsDatas[data.NationalCode] = data.TotalVisitor;
            });
        //World map by jvectormap
        $('#world-map').vectorMap({
            map: 'world_mill_en',
            backgroundColor: "transparent",
            regionStyle: {
                initial: {
                    fill: '#565656',
                    "fill-opacity": 1,
                    stroke: 'none',
                    "stroke-width": 0,
                    "stroke-opacity": 1
                }
            },
            series: {
                regions: [
                    {
                        values: arrVisitorsDatas,
                        scale: ["#FFFFFF", "#FF0000"],
                        normalizeFunction: 'polynomial'
                    }
                ]
            },
            onRegionLabelShow: function(e, el, code) {
                if (typeof arrVisitorsDatas[code] != "undefined")
                    el.html(el.html() + ': ' + arrVisitorsDatas[code].toLocaleString("he-IL") + ' lượt khách');
            }
        });
    });
</script>
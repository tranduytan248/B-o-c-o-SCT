@using TSFramework.App.Processors
@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.ReportGenerateSaleViewModel

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH DU LỊCH</h3>
        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="box-body with-border">
        <div class="row form-horizontal" id="SearchDataReport">
            <div class="col-md-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.OnMonth, new { @class = "control-label col-md-3" })
                    <div class="col-md-3">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </div>
                            @Html.TextBoxFor(model => model.OnMonth, "{0:MM/yyyy}", new { @class = "col-md-9", placeholder = "MM/yyyy" })
                        </div>
                    </div>
                    <div class="col-md-1 text-center">
                        <button type="button" class="btn btn-primary" onclick="_tableDataImport.ajax.reload(null, true);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>

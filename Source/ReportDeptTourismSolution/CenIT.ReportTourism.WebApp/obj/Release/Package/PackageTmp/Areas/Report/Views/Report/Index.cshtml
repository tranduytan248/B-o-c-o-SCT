@using TSFramework.App.Processors
@model List<CenIT.ReportTourism.Core.Interfaces.IPlugableReport>

@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Report_Title");
}

@section Title
{
    @ViewBag.Title
}

@section Action
{

}

<div class="box box-body">
    @{
        foreach (var rpt in Model.OrderBy(rp => rp.ReportName))
        {
            if (!string.IsNullOrEmpty(rpt.ViewName))
            {
                <div class="col-md-12">
                    <p class="text-light-blue">
                        <a data-modal="" data-modal-id="@rpt.ReportKey" href="@Url.Action("ViewReport")?report=@rpt.ReportKey">@rpt.ReportName</a><br/>
                    </p>
                </div>
            }
        }
    }
</div>

@section CustomJS
{
    <script src="@Url.Content("~/Areas/Report/Views/Report/Report.js")"></script>

    @Html.RenderScripts(ScriptPosition.BodyEnd)
}
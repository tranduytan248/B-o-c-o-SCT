@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.ReportDataImportViewModel
@{
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-users"></i>
}

@section FormBody{

<div id="bodyForm">
    <div class="row">
        <div class="col-md-12">
            <label class="bg-red-active">
                Dữ liệu sai so với tháng trước
            </label>
        </div>
        <div class="col-md-12 table-responsive">
            <table id="ViewDataImports" class="table table-bordered table-striped" width="120%">
                <thead>
                <tr>
                    @*<th>@AppProcessor.Messagor.GetMessage("Column_No")</th>*@
                    <th>Chỉ tiêu</th>
                    <th>Đơn vị tính</th>
                    <th>Mã số</th>
                    <th>Số thực hiện kỳ trước</th>
                    <th>Số thực hiện kỳ báo cáo</th>
                    @*<th>Luỹ kế từ đầu năm</th>*@
                    <th>So với cùng kỳ năm trước (%)</th>
                    @*<th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>*@
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">

    eval("@Html.Raw(Model.ReponseMessage)");
    var _tableViewDataImport;
    $(document).ready(function() {
        initTableViewDataImport();
    });

    function initTableViewDataImport() {
        _tableViewDataImport = $("#ViewDataImports").DataTable({
            "Responsive": true,
            "language": {
                "processing":
                    "<div class='overlay custom-loader-background'><i class='fa fa-cog fa-spin custom-loader-color'></i></div>"
            },
            "lengthChange": false,
            "processing": true,
            "serverSide": true,
            "pageLength": 50,
            "info": false,
            "searching": false,
            "paging": false,
            "ajax": {
                "url": "@Url.Action("GetReviewDataImport")",
                "type": "POST",
                "dataType": "JSON",
                "data": {
                    "EnterpriseId": function() { return @Model.EnterpriseId; },
                    "ForMonth": function() { return '@Model.ForMonth.Value.ToString("yyyy-MM-dd")'; }
                }
            },
            "columnDefs": [
                { "width": "120px", "targets": 0 },
                { "width": "10px", "targets": [1, 2, 3, 4, 5, 6] }
            ],
            "columns": [
                //{
                //    "data": "",
                //    "defaultContent": "1",
                //    "render": function (data, type, row, meta) {
                //        return meta.row + 1;
                //    }
                //},
                {
                    "data": "Targets",
                    "defaultContent": ""
                },
                {
                    "data": "Unit",
                    "class": "text-center",
                    "defaultContent": ""
                },
                {
                    "data": "Code",
                    "class": "text-center",
                    "defaultContent": ""
                },
                {
                    "data": "PerformPreviousPeriod",
                    "defaultContent": "",
                    "render": function(data, type, row, meta) {
                        if (type === "display" && data != null) {
                            var html = "";
                            //if (type === "display" && data != null && $.inArray(row.Code, arrCodeCurrency) !== -1) {
                            //    var html = data.toLocaleString("he-IL", { style: "currency", currency: "VND" });
                            html = data.toLocaleString("he-IL");
                            return html;
                        } else if (type === "sort") {
                            return data;
                        }
                        return data;
                    }
                },
                {
                    "data": "PerformInPeriod",
                    "defaultContent": "",
                    "render": function(data, type, row, meta) {
                        if (type === "display" && data != null) {
                            var html = "";
                            //if (type === "display" && data != null && $.inArray(row.Code, arrCodeCurrency) !== -1) {
                            //    var html = data.toLocaleString("he-IL", { style: "currency", currency: "VND" });
                            html = data.toLocaleString("he-IL");
                            return html;
                        } else if (type === "sort") {
                            return data;
                        }
                        return data;
                    }
                },
                //{
                //    "data": "AccumulatedBeginingOfYear",
                //    "defaultContent": "",
                //    "render": function(data, type, row, meta) {
                //        if (type === "display" && data != null && $.inArray(row.Code, arrCodeCurrency) !== -1) {
                //            var html = data.toLocaleString("he-IL", { style: "currency", currency: "VND" });
                //            return html;
                //        } else if (type === "sort") {
                //            return data;
                //        }
                //        return data;
                //    }
                //},
                {
                    "data": "ComparedSamePeriodLastYear",
                    "defaultContent": "",
                    "render": function(data, type, row, meta) {
                        if (type === "display" && data != null) {
                            var html = data.toLocaleString("en-us",
                                { style: "percent", maximumSignificantDigits: 4 });
                            return html;
                        } else if (type === "sort") {
                            return data;
                        }
                        return data;
                    }
                }
            ],
            "rowCallback": function(row, data) {
                if (data.IsWrong) {
                    $(row).addClass('text-bold text-red');
                }
            }
        });
    }
</script>
}

@section submitControl{

}
@using TSFramework.App.Processors
@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Authorize_Login")} VNPT SmartCA";
}

<div class="modal-header bg-primary">
    <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
        <span aria-hidden="true">&times;</span>
    </button>
    <h4 class="modal-title"><i class="fa fa-unlock"></i>&nbsp;@Html.Raw(ViewBag.Title)</h4>
</div>
<div class="modal-body">
    @using (Ajax.BeginForm("LoginSmartCA", "DigitalSign", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "LoginSmartCA_OnProcessSuccess(data, 'LoginSmartCA')"
    }, new { @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            <div class="logo-img text-center">
                <a href="https://smartca.vnpt.vn/" target="_blank">
                    <img alt="" src="~/Contents/imgs/VNPT SmartCA.png" width="30%" />
                </a>
                <hr style="border-color: #0073b7; margin-bottom: 0;">
            </div>
            <div class="login-box-body">
                <div class="form-group">
                    <span class="text-center text-blue" style="font-size: large"><i class="fa fa-unlock-alt"></i> ĐĂNG NHẬP</span>
                </div>

                <div id="ContentLogin">
                    @Html.Partial("_LoginSmartCA")
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-flat pull-left">
                        <i class="fa fa-key"></i>&nbsp;Đăng Nhập
                    </button>
                </div>

                <div class="social-auth-links text-center">
                    <hr style="border-color: #0073b7" />
                    <div class="logo_footer">
                        <a href="https://vnpt.com.vn/" target="_blank">
                            <img width="75%" src="/Contents/imgs/logo_footer.png">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
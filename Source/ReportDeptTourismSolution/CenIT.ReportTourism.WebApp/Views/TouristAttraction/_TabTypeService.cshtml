        @Html.Button(true, "AddTypeService", Url.Action("AddTypeService", new { area = "", enterpriseId = Model }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-sm btn-success pull-right" })
    </div>
    <div class="clearfix">
        <hr/>
    </div>
    <div class="col-md-12 table-responsive">
        <table id="DataTypeServices" class="table table-bordered table-striped" width="100%">
            <thead>
            <tr>
                <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                <th>@AppProcessor.Messagor.GetMessage("TouristAttractionTypeService_Label_Name")</th>
                <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
            </tr>
            </thead>
        </table>
    </div>
</div>
<script type="text/javascript">
    var enterpriseId = @Model;
</script>

<script src="@Url.Content("~/Views/TouristAttraction/TypeService.js")"></script>
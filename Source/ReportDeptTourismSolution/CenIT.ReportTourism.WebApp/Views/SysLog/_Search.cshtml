@using TSFramework.App.Processors

<div class="col-md-12">
    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Tìm kiếm</h3>

            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
        </div>
        <!-- /.box-header -->
        <div class="box-body form-horizontal" id="SearchFile">
            <div class="col-md-12">
                <div class="form-group">
                    <label class="control-label col-md-2">Tháng</label>
                    <div class="col-md-3">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar fa-lg"></i>
                            </div>
                            @Html.TextBox("FromMonth", DateTime.Now.ToString("MM/yyyy"), new { @class = "col-md-4 col-sm-6", placeholder = "MM/yyyy" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar fa-lg"></i>
                            </div>
                            @Html.TextBox("ToMonth", DateTime.Now.ToString("MM/yyyy"), new { @class = "col-md-4 col-sm-6", placeholder = "MM/yyyy" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
        <!-- ./box-body -->
        <div class="box-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="OnSearchFile()"><i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")</button>
            </div>
        </div>
    </div>
</div>


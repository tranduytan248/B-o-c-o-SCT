@using System.Text.RegularExpressions
@model CenIT.ReportTourism.WebApp.Models.SysLogModel

<ul class="todo-list" id="ErrFiles">
    @{
        foreach (var fi in Model.ListErrFile)
        {
            <li id="@Regex.Replace(fi.Name, @"[^0-9a-zA-Z]+", "", RegexOptions.Compiled)">
                <span class="handle">
                    <i class="fa fa-ellipsis-v"></i>
                    <i class="fa fa-ellipsis-v"></i>
                </span>
                <span class="text">@fi.Name</span>
                @*<a data-width="1024px" data-modal="" data-modal-id="ViewErrFile" href="@Url.Action("ViewErrFile", new { fileName = fi.Name })"><span class="text">@fi.Name</span></a>*@
                <!-- Emphasis label -->
                <small class="label label-danger">
                    <i class="fa fa-clock-o"></i> @fi.LastAccessTime.ToString("dd/MM/yyyy HH:mm:ss")
                </small>
                <!-- General tools such as edit or delete-->
                <div class="tools">
                    <a href="@Url.Action("DownloadFile", new {fileName = fi.Name, type = "Err"})" class="label label-default">
                        <i class="fa fa-cloud-download"></i>
                    </a>
                    <a data-modal="" data-modal-id="DeleteFile" href="@Url.Action("DeleteFile", new {fileName = fi.Name, type = "Err"})" class="label label-danger">
                        <i class="fa fa-trash-o"></i>
                    </a>
                </div>
            </li>
        }
    }

</ul>
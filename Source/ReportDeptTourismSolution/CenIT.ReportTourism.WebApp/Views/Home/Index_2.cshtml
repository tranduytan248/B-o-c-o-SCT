@model CenIT.ReportTourism.Models.BaseApp.SysLayoutModel

@{
    ViewBag.Title = "Dashboard";
}

@section HeadJs{
}

@section HeadCss{
    <style type="text/css">
        .box-border { border: 1px solid #CCC; }

        .widget-panel {
            -webkit-box-shadow: none;
            box-shadow: none;
            margin: 3px 0;
            padding: 0;
        }
    </style>

}

@section Title{
    @ViewBag.Title
}

@section Action{
    <button id="btnEdit" class="btn btn-default" title="Chỉnh sửa trang" data-toggle="tooltip" onclick="editDashboard(this)"><i class="fa fa-gears"></i>&nbsp;Chỉnh sửa</button>
    <button id="btnApply" class="btn btn-success hidden" title="Lưu" data-toggle="tooltip" onclick="applyDashboard(this)"><i class="fa fa-check"></i>&nbsp;Lưu</button>
    <button id="btnCancel" class="btn btn-danger hidden" title="Huỷ" data-toggle="tooltip" onclick="cancelApplyDashboard(this)"><i class="fa fa-ban"></i>&nbsp;Huỷ</button>
}

<div class="row">
    @{
        var iCol = 12 / Model.NumberCol;
        foreach (var p in Model.ContentPanels)
        {
            var classCol = $"col-sm-{p.WidthCol * iCol}";
            var urlAction = Url.Action("RenderModule", new {widgetId = p.ContentPanelName});

            <div class="col-xs-12 @classCol">
                <div id="panel_@p.ContentPanelId" class="row widget-panel">
                    <div id="@p.ContentPanelId" name="@p.ContentPanelName" class="widget-container-col ui-sortable" data-url="@urlAction"></div>
                </div>
            </div>
        }
    }
</div>

@section CustomJS
{
    <script src="@Url.Content("~/Views/Home/Home.js")"></script>
}
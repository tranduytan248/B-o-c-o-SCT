@using TSFramework.App.Processors
@model int
<section class="content box box-body no-border no-footer">
    <div class="row">
        <div class="col-md-12">
            @Html.Button(true, "AddTypeService", Url.Action("AddTypeService", new {area = "Cate", enterpriseId = Model}), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new {@class = "btn btn-sm btn-success pull-right"})
        </div>
        <div class="clearfix">
            <hr/>
        </div>
        <div class="col-md-12 table-responsive">
            <table id="DataTypeServices" class="table table-bordered table-striped" width="100%">
                <thead>
                <tr>
                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                    <th>@AppProcessor.Messagor.GetMessage("AccommodationTypeService_Label_Name")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
</section>
<script type="text/javascript">
    var enterpriseId = @Model;
</script>

<script src="@Url.Content("~/Areas/Cate/Views/TypeAccommodation/TypeService.js")"></script>
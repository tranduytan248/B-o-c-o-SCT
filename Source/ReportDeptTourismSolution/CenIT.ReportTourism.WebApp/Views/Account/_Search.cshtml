@using TSFramework.App.Processors
@model CenIT.ReportTourism.WebApp.Models.SearchEnterpriseModel

<!-- Control Sidebar -->
<aside class="control-sidebar control-sidebar-dark">
    <div class="box-body">
        <div class="login-box">
            <div class="login-box-body" style="padding: 0 20px">
                @using (Ajax.BeginForm("Search", "Account", new AjaxOptions
                {
                    HttpMethod = "POST",
                    OnSuccess = "Search_OnProcessSuccess(data, 'SearchEnterprise')"
                }, new {@class = "form-horizontal", id = "SearchEnterprise"}))
                {
                    <h2>
                        <i class="fa fa-search text-success"></i>
                        <label class="control-label" style="color: #0073b7;">Tra cứu Doanh nghiệp</label>
                    </h2>
                    <div class="col-md-12">
                        <div class="form-group">
                            <h4>
                                <label class="control-label" style="color: #0073b7;">
                                    <i class="fa fa-bank text-success"></i>&nbsp; @AppProcessor.Messagor.GetMessage("Enterprise_Label_Name")
                                </label>
                            </h4>
                            @Html.TextBoxFor(model => model.EnterpriseName, new {@class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_Name")})
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <h4>
                                <label class="control-label" style="color: #0073b7;">
                                    <i class="fa fa-code text-success"></i>&nbsp; @AppProcessor.Messagor.GetMessage("Enterprise_Label_TaxCode")
                                </label>
                            </h4>
                            @Html.TextBoxFor(model => model.TaxCode, new {@class = "col-md-8", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_TaxCode")})
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <h4>
                                <label class="control-label" style="color: #0073b7;">
                                    <i class="fa fa-envelope text-success"></i>&nbsp; @AppProcessor.Messagor.GetMessage("Enterprise_Label_Email")
                                </label>
                            </h4>
                            @Html.TextBoxFor(model => model.Email, new {@class = "col-md-8", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_Email")})
                        </div>
                    </div>
                    <div class="col-md-12">
                        <h4>
                            <hr class="text-success"/>
                        </h4>
                        <div class="form-group">
                            <button type="submit" id="btnSearch" class="btn btn-primary"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div id="SearchResult">

    </div>
</aside>
<!-- /.control-sidebar -->
<div class="control-sidebar-bg"></div>

<script type="text/javascript">

    function Search_OnProcessSuccess(response, formId) {
        if (typeof response != "undefined") {
            $("#SearchResult").html(response);
        }
    }

</script>
@using TSFramework.App.Processors
@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Button_Register")} Doanh nghiệp";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Html.BeginForm("Register", "Account", new { area = "" }, FormMethod.Post, new { encType = "multipart/form-data", id = "Register", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_RegisterBox")
        </div>
    }
    <script type="text/javascript">
        debugger;
        $('form#Register').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    //$("#ModalContent #modal_Register").modal("hide");
                    //$("#ModalContent #modal_Register").on('hidden.bs.modal',
                    //    function() {
                    //if (response.status != undefined) {
                    eval(response.message);
                    if (response.status) {
                        var a = document.createElement('a');
                        a.style.display = 'none';
                        a.href = "@Url.Action("RegisterSuccess")?email=" + response.email;
                        a.class = "btn hidden";
                        a.setAttribute("data-modal", "true");
                        a.setAttribute("data-modal-id", "RegisterSuccess");
                        document.body.appendChild(a);
                        a.click();
                    }
                    //}
                    response.status = undefined;
                    //});
                } else {
                    $("#ModalContent #modal_Register" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}
@model CenIT.ReportTourism.WebApp.Models.ResetPasswordModel

@{
    var skinName = ViewBag.ActivatedLayout;
    skinName = skinName ?? "_Default";
    var skinView = $"~/Views/Skin/{skinName}/{skinName}.cshtml";
    if (!File.Exists(Server.MapPath(skinView)))
    {
        skinView = "~/Views/Skin/_Default/_Default.cshtml";
    }
    Layout = skinView;
    ViewBag.Title = "Đổi mật khẩu";
}

@section HeadCss{
    <link href="~/Contents/plugins/login/style.css" rel="stylesheet" />
    <style type="text/css">
        .login-box-body, .register-box-body { background: inherit; }

        .layout-boxed {
            background-image: url('/Contents/imgs/background-sct.png');
            background-repeat: no-repeat;
            background-size: cover;
        }

        .logo-img img { width: 30%; }

        .login-box-body { padding: 20px 20px 10px 20px; }

        .login-box-body h2 { margin-top: 10px; }

        .widget-box {
            background-color: rgba(255, 255, 255, 0.44);
            border-bottom: none;
            box-shadow: none;
            margin: 10% auto 0;
            position: relative;
            visibility: visible;
        }

        .logo-img hr {
            border-color: #0073b7;
            margin-bottom: 0;
        }
    </style>
}

<div class="signin login-box widget-box visible">
    <div class="logo-img text-center">
        <a href="/">
            <img alt="" src="~/Contents/imgs/logo-sct.png" />
            <h2 class="box-title text-blue" style="font-size: 150%; font-weight: 600">
                HỆ THỐNG BÁO CÁO <br>SỞ CÔNG THƯƠNG
            </h2>
        </a>
        <hr style="border-color: #0073b7; margin-bottom: 0;">
    </div>
    <div class="login-box-body">
        @using (Html.BeginForm("RequireChangePassword", "Account", new { area = "", returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { id = "RequireChangePasswordForm", role = "form" }))
        {
            @Html.AntiForgeryToken()
            <div id="ContentRequireChangePassword">
                @Html.Partial("_RequireChangePassword", Model)
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <button type="submit" class="btn btn-primary btn-flat pull-left">
                        <i class="fa fa-save"></i>
                        Cập nhật
                    </button>
                    <a class="btn btn-default btn-flat pull-right" href="@Url.Action("Logout", "Account", new { area = "" })">
                        <i class="fa fa-sign-out"></i>
                        Đăng xuất
                    </a>
                </div>
            </div>
            <hr />
        }
    </div>
</div>

@section CustomJS
{
    <script type="text/javascript">
        $("body").removeAttr('class');
        $("body").addClass("hold-transition layout-boxed");

        function _showPassword(inpt) {
            if ('password' == $(inpt).attr('type')) {
                $(inpt).prop('type', 'text');
            } else {
                $(inpt).prop('type', 'password');
            }
        }

        // Cùng quy tắc với server (AccountController.RequireChangePassword)
        function _passwordErrors(pwd) {
            var errors = [];
            if (!/^[\x20-\x7E]*$/.test(pwd)) errors.push('Không dùng chữ có dấu hoặc ký tự ngoài bàn phím');
            if (pwd.length < 8 || pwd.length > 128) errors.push('Dài từ 8 đến 128 ký tự');
            if (!/[a-z]/.test(pwd)) errors.push('Có ít nhất 1 chữ thường');
            if (!/[A-Z]/.test(pwd)) errors.push('Có ít nhất 1 chữ hoa');
            if ((pwd.match(/[0-9]/g) || []).length < 2) errors.push('Có ít nhất 2 ký tự số');
            if (!/[^a-zA-Z0-9]/.test(pwd)) errors.push('Có ít nhất 1 ký tự đặc biệt');
            return errors;
        }

        function _validatePassword() {
            var $pwd = $('#NewPassword'), $confirm = $('#ConfirmPassword');
            var pwd = $pwd.val() || '', confirm = $confirm.val() || '';
            var errors = _passwordErrors(pwd);
            var match = pwd === confirm;

            var $msg = $("span[data-valmsg-for='NewPassword']").empty();
            $.each(errors, function (idx, msg) { $msg.append('<p class="text-red">' + msg + '</p>'); });
            var $confirmMsg = $("span[data-valmsg-for='ConfirmPassword']").empty();
            if (!match && confirm.length > 0) $confirmMsg.append('<p class="text-red">Mật khẩu nhập lại không khớp</p>');

            $pwd.css("border", "1px solid " + (errors.length ? "#dd4b39" : "#00a65a"));
            $confirm.css("border", "1px solid " + (errors.length || !match ? "#dd4b39" : "#00a65a"));
            return errors.length === 0 && match && confirm.length > 0;
        }

        $(document).ready(function () {
            var $form = $('form#RequireChangePasswordForm');
            var $submit = $form.find('button[type=submit]');

            $(document).on('keyup change', '#NewPassword, #ConfirmPassword', _validatePassword);

            $form.ajaxForm({
                beforeSubmit: function () {
                    if (!_validatePassword()) return false;
                    $submit.attr("disabled", true);
                    return true;
                },
                success: function (response, statusText, xhr) {
                    // Phiên đăng nhập hết hạn / trang lỗi: tải lại để được chuyển về trang đăng nhập
                    if (typeof response === 'string' && (/<html/i.test(response) || xhr.getResponseHeader('x-responded-json'))) {
                        window.location.reload();
                        return;
                    }
                    if (response.status != undefined) {
                        eval(response.message);
                        if (response.returnUrl) {
                            setTimeout(function () {
                                window.location = window.location.origin + response.returnUrl;
                            }, 1500);
                            return;
                        }
                    } else {
                        $form.find("#ContentRequireChangePassword").html(response);
                    }
                    $submit.removeAttr("disabled");
                },
                error: function () {
                    toastr.error('Đổi mật khẩu không thành công. Trang sẽ được tải lại.');
                    setTimeout(function () { window.location.reload(); }, 1500);
                }
            });
        });
    </script>
}

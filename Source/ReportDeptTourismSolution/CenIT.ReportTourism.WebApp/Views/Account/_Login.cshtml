@using CaptchaMvc.HtmlHelpers
@using TSFramework.App.Processors
@model CenIT.ReportTourism.WebApp.Models.LoginModel
@Html.AntiForgeryToken()
<div class="form-group has-feedback">
    <span class="fa fa-envelope form-control-feedback"></span>
    @Html.TextBoxFor(model => model.Email, new {@class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Account")})
    @Html.ValidationMessageFor(model => model.Email, "", new {@class = "text-danger"})
</div>
<div class="form-group has-feedback">
    <span class="fa fa-lock form-control-feedback"></span>
    @Html.TextBoxFor(model => model.Password, new {type = "Password", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Password") })
    @Html.ValidationMessageFor(model => model.Password, "", new {@class = "text-danger"})
</div>
@{
    if (Model.NeedCaptcha)
    {
        <div class="form-group has-feedback">
            @Html.Captcha("Làm mới", "Nhập captcha", 7, "Bạn chưa nhập Captcha")
        </div>
    }
}

@section CustomJS
{
    <script type="text/javascript">
        $("body").removeAttr('class');
        $("body").addClass("hold-transition login-page");
        $(document).ready(function() {
            $("#CaptchaInputText").addClass("form-control");
        });
    </script>
}
@model List<CenIT.ReportTourism.Models.Cate.CateEnterpriseModel>
<div class="box">
    <div class="box-header with-border">
        <i class="fa fa-list"></i>&nbsp;
        <h3 class="box-title">Kết quả</h3>
    </div>
    <div class="box-body" style="max-height: 500px; overflow: auto;">
        @{
            if (Model == null || !Model.Any())
            {
                <strong class="text-danger"><i class="fa fa-exclamation margin-r-5"></i>Không tìm thấy</strong>
            }
            else
            {
                foreach (var enterpriseModel in Model)
                {
                    <p class="text-primary text-bold">
                        <i class="fa fa-bank margin-r-5"></i> @enterpriseModel.BusinessName</p>

                    <p class="text-yellow">
                        <i class="fa fa-code"></i>&nbsp;@enterpriseModel.TaxCode
                    </p>
                    <p class="text-success">
                        <i class="fa fa-envelope"></i>&nbsp;@enterpriseModel.Email
                    </p>
                    <hr>
                }
            }
        }
    </div>
</div>
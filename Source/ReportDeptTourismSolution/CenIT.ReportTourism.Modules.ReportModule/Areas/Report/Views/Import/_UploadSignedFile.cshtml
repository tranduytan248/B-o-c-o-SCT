@model CenIT.ReportTourism.Models.Report.ReportDataImportModel
<div class="form-group">
    @Html.TitleFor(model => model.FileImport, new { @class = "control-label col-md-3" })
    <div class="col-md-9">
        @Html.FileFor(model => model.FileImport, ".xlsx,.xls", false, new { @class = "col-md-8" })
        @Html.ValidationMessageFor(model => model.FileImport, "", new { @class = "text-danger" })
    </div>
</div>

@Html.RenderScripts(ScriptPosition.BodyInside)
@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ReportDataImport_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Import", new { area = "Report" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "DataImport_OnProcessSuccess(data, 'DeleteDataImport')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.Partial("_DeleteView")
    }
}
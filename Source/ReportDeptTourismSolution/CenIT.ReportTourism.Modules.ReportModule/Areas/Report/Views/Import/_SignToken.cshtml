@model string
@{
    ViewBag.Title = "Ký số VNPT Token";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-navy
}

@section FormIcon{
    <i class="fa fa-pencil"></i>
}

@section FormBody{

    <script src="~/Contents/Modules/Report/plugins/vnpt-ca/vnpt-plugin.js"></script>
    <script src="~/Contents/Modules/Report/plugins/vnpt-ca/base64.js"></script>
    <script src="~/Areas/Report/Views/Import/_VNPTToken.js"></script>
    @*<script src="~/Areas/Report/Views/Home/Home.js"></script>*@

    <div class="box box-body no-border no-header no-shadow form-horizontal" id="SignTokenArea">
        <div class="overlay hidden" id="loading">
            <i class="fa fa-refresh fa-spin"></i>
            <p id="message" class="text-center text-bold text-danger">...</p>
        </div>
        @Html.Hidden("_SerialKey", Model, new { id = "_SerialKey" })

        <div class="form-group">
            <label class="control-label col-md-3">Tệp dữ liệu</label>
            <div class="col-md-9">
                @Html.ChooseFile("FileImport", ".xlsx,.xls,.xml,.pdf,.docx,.pptx,.txt", false, new { @class = "col-md-12" })
            </div>
        </div>
        <div class="form-group hidden" id="AdvancedSignArea">
            <label class="control-label col-md-3"></label>
            <div class="col-md-9">
                <div class="checkbox">
                    @Html.CheckBox("AdvancedSign", false, new { id = "AdvancedSign", @class = "hidden" })
                    <label for="AdvancedSign">Ký nâng cao</label>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">

        /* Sign plugin */
        $('#inputFile_FileImport button.btn-choose').click(function() {
            checkPlugin(checkPluginCallback);
        });

    </script>
}

@section SubmitControl{
    <button type="button" onclick="sign()" class="btn bg-navy" id="_Sign"><i class="fa fa-save"></i>&nbsp; Ký dữ liệu</button>
}
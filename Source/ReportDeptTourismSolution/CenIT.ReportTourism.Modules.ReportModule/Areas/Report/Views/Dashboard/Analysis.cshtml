@model CenIT.ReportTourism.Models.Report.DashboardAnalysisModel
@using CenIT.ReportTourism.Models.Report
@using System.Linq
@{
    ViewBag.Title = DashboardText.Get("Analysis_Title");
}
@section Title { @ViewBag.Title <small class="dashboard-subtitle">@Model.TypeName · @DashboardText.Get("Month") @Model.Filters.Month.ToString("00")/@Model.Filters.Year</small> }
@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/morris/morris.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}
@{
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var unit = Model.SelectedMetric.Unit;
    var momTone = Model.Mom > 0 ? "bg-green" : Model.Mom < 0 ? "bg-red" : "bg-gray";
    var momIcon = Model.Mom > 0 ? "fa-arrow-up" : Model.Mom < 0 ? "fa-arrow-down" : "fa-minus";
    var yoyTone = Model.Yoy > 0 ? "bg-green" : Model.Yoy < 0 ? "bg-red" : "bg-gray";
    var yoyIcon = Model.Yoy > 0 ? "fa-arrow-up" : Model.Yoy < 0 ? "fa-arrow-down" : "fa-minus";
    var sectors = Model.Sectors.Where(x => x.Value > 0).Take(6).ToList();
}
<div class="management-dashboard dashboard-analysis-page">
    <div class="nav-tabs-custom">
        @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Analysis", Filters = Model.Filters })
        <div class="tab-content">
            @Html.Partial("_DashboardFilters", Model.FilterOptions)
        </div>
    </div>

    <div class="row dashboard-equal-row">
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-light-blue">
                <div class="inner">
                    <h3>@Model.CurrentValue <sup>@unit</sup></h3>
                    <p><b>@DashboardText.Get("Analysis_CurrentPeriodCode") @Model.SelectedMetric.Code</b><br />@Model.SelectedMetric.Label</p>
                </div>
                <div class="icon"><i class="fa fa-line-chart" aria-hidden="true"></i></div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-aqua">
                <div class="inner">
                    <h3>@Model.YtdValue <sup>@unit</sup></h3>
                    <p><b>@DashboardText.Get("Analysis_YtdTitle")</b><br />@Model.YtdMonths/@Model.Filters.Month @DashboardText.Get("Analysis_YtdNote")</p>
                </div>
                <div class="icon"><i class="fa fa-calendar" aria-hidden="true"></i></div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box @momTone">
                <div class="inner">
                    <h3>@(Model.Mom.HasValue ? String.Format("{0:+0.0;-0.0;0.0}%", Model.Mom.Value) : "—")</h3>
                    <p><b>@DashboardText.Get("Analysis_Mom")</b><br />@Model.MomCompared/@Model.Assigned @DashboardText.Get("Analysis_ComparedCoverage")</p>
                </div>
                <div class="icon"><i class="fa @momIcon" aria-hidden="true"></i></div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box @yoyTone">
                <div class="inner">
                    <h3>@(Model.Yoy.HasValue ? String.Format("{0:+0.0;-0.0;0.0}%", Model.Yoy.Value) : "—")</h3>
                    <p><b>@DashboardText.Get("Analysis_Yoy")</b><br />@Model.YoyCompared/@Model.Assigned @DashboardText.Get("Analysis_ComparedCoverage")</p>
                </div>
                <div class="icon"><i class="fa @yoyIcon" aria-hidden="true"></i></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-bar-chart text-light-blue" aria-hidden="true"></i> @DashboardText.Get("Analysis_Trend") @Model.SelectedMetric.Label</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Months12") · @unit</span></div>
                </div>
                <div class="box-body">
                    <div id="analysis-trend-chart" data-labels="@(Newtonsoft.Json.JsonConvert.SerializeObject(new[] { DashboardText.Get("Value") }))" data-empty="@DashboardText.Get("ChartEmpty")" class="chart dashboard-chart" role="img" aria-label="@DashboardText.Get("Analysis_TrendAria") @Model.SelectedMetric.Label"></div>
                    <script type="application/json" class="md-chart-data" data-chart="analysis-trend">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Trend))</script>
                    <p class="text-muted small no-margin">@DashboardText.Get("Analysis_TrendNote")</p>
                </div>
                <div class="box-footer">
                    <button type="button" class="btn btn-link dashboard-values-toggle" data-toggle="collapse" data-target="#analysis-trend-values" aria-expanded="false" aria-controls="analysis-trend-values"><i class="fa fa-table" aria-hidden="true"></i> @DashboardText.Get("ChartValues")</button>
                    <div id="analysis-trend-values" class="collapse">
                        <div class="table-responsive">
                            <table class="table table-condensed table-striped">
                                <thead><tr><th>@DashboardText.Get("Month")</th><th class="text-right">@DashboardText.Get("Value") (@unit)</th></tr></thead>
                                <tbody>@foreach (var point in Model.Trend) { <tr><td>@point.Month</td><td class="text-right">@(point.Value.HasValue ? point.Value.Value.ToString("#,##0.##") : DashboardText.Get("Analysis_NoData"))</td></tr> }</tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-pie-chart text-aqua" aria-hidden="true"></i> @DashboardText.Get("Analysis_SectorTitle")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Analysis_Share")</span></div>
                </div>
                <div class="box-body dashboard-breakdown-grid">
                    @if (!sectors.Any()) { <p class="text-muted no-margin">@DashboardText.Get("Analysis_NoSectorValue")</p> }
                    @foreach (var item in sectors)
                    {
                        <div class="progress-group">
                            <span class="progress-text">@item.Name</span>
                            <span class="progress-number"><b>@String.Format("{0:0.#}%", item.Share)</b></span>
                            <div class="progress sm"><div class="progress-bar progress-bar-aqua" style="width: @Math.Min(100, item.Share).ToString("0.#", invariant)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-exchange" aria-hidden="true"></i> @DashboardText.Get("Analysis_LargestEnterpriseChanges")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Analysis_ComparableGroup")</span></div>
                </div>
                <div class="box-body">
                    @if (!Model.Movements.Any())
                    {
                        <p class="text-muted text-center no-margin">@DashboardText.Get("Analysis_NoComparison")</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover no-margin">
                                <thead><tr><th style="width: 40px;">#</th><th>@DashboardText.Get("Enterprise")</th><th class="text-right">@DashboardText.Get("PreviousPeriod") (@unit)</th><th class="text-right">@DashboardText.Get("CurrentPeriod") (@unit)</th><th class="text-right">@DashboardText.Get("Change")</th></tr></thead>
                                <tbody>
                                    @{ var rank = 0; }
                                    @foreach (var item in Model.Movements)
                                    {
                                        rank++;
                                        <tr><td>@(rank).</td><td>@item.Name</td><td class="text-right">@item.PreviousValue.ToString("#,##0.##")</td><td class="text-right">@item.CurrentValue.ToString("#,##0.##")</td><td class="text-right text-bold @(item.Change < 0 ? "text-red" : "text-green")">@String.Format("{0:+#,##0.##;-#,##0.##;0}", item.Change)</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <p class="text-muted small"><i class="fa fa-info-circle" aria-hidden="true"></i> @DashboardText.Get("Analysis_ComparisonNote")</p>
</div>
@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/morris/raphael-min.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/morris/morris.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}

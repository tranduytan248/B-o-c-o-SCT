@model System.Data.DataTable
@using System.Data
@using CenIT.ReportTourism.Models.Report
@if (Model.Rows.Count == 0) { <p class="text-muted">Chưa có dữ liệu chỉ tiêu cho doanh nghiệp, loại báo cáo và kỳ đã chọn.</p> }
else {
    <p><b>@Model.Rows[0]["EnterpriseName"]</b> · Tháng @Convert.ToDateTime(Model.Rows[0]["ForMonth"]).ToString("MM/yyyy")</p>
    <p class="text-muted small">Giá trị và đơn vị gốc do doanh nghiệp báo cáo. Các trường kỳ trước / kế hoạch là số khai báo, không thay thế dữ liệu lịch sử đã kiểm chứng.</p>
    <div class="table-responsive"><table class="table table-striped table-condensed"><thead><tr><th>Mã</th><th>Chỉ tiêu</th><th>Đơn vị gốc</th><th class="text-right">Trong kỳ</th><th class="text-right">Kỳ trước khai báo</th><th class="text-right">Kế hoạch năm khai báo</th></tr></thead><tbody>
        @foreach (DataRow row in Model.Rows) {
            <tr><td>@row["Code"]</td><td>@row["Targets"]</td><td>@row["Unit"]</td>
            @foreach (var key in new[] { "PerformInPeriod","PerformPreviousPeriod","AccumulatedBeginingOfYear" }) {
                <td class="text-right" title="@(row[key] == DBNull.Value ? "Chưa có dữ liệu" : Convert.ToString(row[key],System.Globalization.CultureInfo.InvariantCulture))">@DashboardNumber.Amount(row[key] == DBNull.Value ? (decimal?)null : Convert.ToDecimal(row[key]))</td>
            }</tr>
        }
    </tbody></table></div>
}

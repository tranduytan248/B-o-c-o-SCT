@model CenIT.ReportTourism.Models.Report.DashboardWarningsModel
@using System.Linq

@{
    ViewBag.Title = "Cảnh báo doanh nghiệp";
    var maxIndWarning = Math.Max(1, Model.ByIndustry.Any() ? Model.ByIndustry.Max(x => (int)x.Contribution) : 1);
}

@section Title { @ViewBag.Title }

@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/morris/morris.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}

<div class="management-dashboard">
    @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Warnings", Filters = Model.Filters })
    
    <div class="dashboard-heading">
        <div>
            <h1 id="dashboard-content" tabindex="-1">Cảnh báo biến động doanh nghiệp</h1>
            <p>Doanh thu công nghiệp trong nhóm theo dõi so với tháng trước <span class="scope-badge">Cần hai kỳ có dữ liệu</span></p>
        </div>
        <span class="dashboard-updated"><i class="fa fa-clock-o" aria-hidden="true"></i> Kỳ báo cáo: @Model.Filters.Month.ToString("00")/@Model.Filters.Year</span>
    </div>

    @Html.Partial("_DashboardFilters", Model.FilterOptions)
    
    @if (!Model.HasComparisonData)
    {
        <p class="dashboard-empty">Chưa có hai tháng liên tiếp với doanh thu công nghiệp của cùng doanh nghiệp; chưa thể đánh giá mức giảm.</p>
    }

    <div class="row warning-kpis">
        <div class="col-xs-6 col-md-3">
            <article class="warning-kpi level-10">
                <span>Giảm trên 10%</span>
                <strong>@(Model.HasComparisonData ? Model.Summary.DeclineOver10.ToString() : "—")</strong>
                <small>@(Model.HasComparisonData ? "doanh nghiệp" : "chưa đủ lịch sử")</small>
            </article>
        </div>
        <div class="col-xs-6 col-md-3">
            <article class="warning-kpi level-20">
                <span>Giảm trên 20%</span>
                <strong>@(Model.HasComparisonData ? Model.Summary.DeclineOver20.ToString() : "—")</strong>
                <small>@(Model.HasComparisonData ? "doanh nghiệp" : "chưa đủ lịch sử")</small>
            </article>
        </div>
        <div class="col-xs-6 col-md-3">
            <article class="warning-kpi level-30">
                <span>Giảm trên 30%</span>
                <strong>@(Model.HasComparisonData ? Model.Summary.DeclineOver30.ToString() : "—")</strong>
                <small>@(Model.HasComparisonData ? "doanh nghiệp" : "chưa đủ lịch sử")</small>
            </article>
        </div>
        <div class="col-xs-6 col-md-3">
            <article class="warning-kpi level-urgent">
                <span>Cần làm việc ngay</span>
                <strong>@(Model.HasComparisonData ? Model.Summary.UrgentEnterprises.ToString() : "—")</strong>
                <small>@(Model.HasComparisonData ? "doanh nghiệp" : "chưa đủ lịch sử")</small>
            </article>
        </div>
    </div>

    <div class="row dashboard-row">
        <div class="col-md-4">
            <section class="dashboard-panel severity-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Mức độ cảnh báo</h2>
                        <p>Phân bố theo ngưỡng giảm (các mức không trùng lặp)</p>
                    </div>
                </header>
                @if (!Model.HasComparisonData)
                {
                    <p class="dashboard-empty">Chưa có kỳ đối chiếu hợp lệ để phân loại mức giảm.</p>
                }
                else if (Model.Summary.DeclineOver10 == 0)
                {
                    <p class="dashboard-empty">Không có doanh nghiệp giảm trên 10% trong các cặp dữ liệu hợp lệ.</p>
                }
                else
                {
                    <div id="warning-severity-chart" class="severity-chart" role="img" aria-label="Phân bố mức độ cảnh báo"></div>
                }
                <script type="application/json" class="md-chart-data" data-chart="severity">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.HasComparisonData ? new[] {
                    new { label = "Giảm 10–20%", value = Model.Summary.DeclineOver10 - Model.Summary.DeclineOver20 },
                    new { label = "Giảm 20–30%", value = Model.Summary.DeclineOver20 - Model.Summary.DeclineOver30 },
                    new { label = "Giảm trên 30%", value = Model.Summary.DeclineOver30 }
                } : new object[0]))</script>
            </section>
        </div>
        <div class="col-md-8">
            <section class="dashboard-panel warning-trend-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Cảnh báo theo thời gian</h2>
                        <p>Số doanh nghiệp có mức giảm vượt ngưỡng qua các tháng</p>
                    </div>
                </header>
                @if (Model.Trend.Count < 2)
                {
                    <p class="dashboard-empty">Chưa đủ tháng có cặp dữ liệu để hiển thị xu hướng cảnh báo.</p>
                }
                else
                {
                    <div id="warning-trend-chart" class="morris-chart warning-trend-chart" role="img" aria-label="Xu hướng cảnh báo theo tháng"></div>
                }
                <script type="application/json" class="md-chart-data" data-chart="warning-trend">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Trend))</script>
            </section>
        </div>
    </div>

    <div class="row dashboard-row">
        <div class="col-md-4">
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Cảnh báo theo ngành</h2>
                        <p>Số doanh nghiệp giảm doanh thu vượt ngưỡng</p>
                    </div>
                </header>
                @if (Model.ByIndustry.Count == 0)
                {
                    <p class="dashboard-empty">Chưa có cảnh báo theo ngành.</p>
                }
                @foreach (var item in Model.ByIndustry)
                {
                    <div class="compact-impact-row">
                        <span title="@item.Name">@item.Name</span>
                        <div class="ranked-bar-track">
                            <span class="ranked-bar warning" style="width:@((item.Contribution * 100 / maxIndWarning))%"></span>
                        </div>
                        <strong>@item.Contribution</strong>
                    </div>
                }
            </section>
        </div>
        <div class="col-md-8">
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <div>
                        <h2>Danh sách doanh nghiệp cần ưu tiên xử lý</h2>
                        <p>Sắp xếp theo mức độ sụt giảm tuyệt đối (Tỷ đồng) và tỷ lệ giảm (%)</p>
                    </div>
                </header>
                @if (Model.UrgentEnterprises.Count == 0)
                {
                    <p class="dashboard-empty">Chưa có doanh nghiệp vượt ngưỡng cảnh báo trong kỳ báo cáo này.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-enterprise table-hover">
                            <thead>
                                <tr>
                                    <th>Doanh nghiệp</th>
                                    <th>Ngành chính</th>
                                    <th class="num-col">Kỳ trước</th>
                                    <th class="num-col">Kỳ này</th>
                                    <th class="num-col">Tỷ lệ giảm</th>
                                    <th class="num-col">Biến động (Tỷ)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.UrgentEnterprises)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Name</strong>
                                        </td>
                                        <td>
                                            <span class="badge-tone tone-slate">@item.Industry</span>
                                        </td>
                                        <td class="num-col">
                                            @item.PreviousValue.ToString("#,##0.##")
                                        </td>
                                        <td class="num-col">
                                            @item.CurrentValue.ToString("#,##0.##")
                                        </td>
                                        <td class="num-col">
                                            <span class="badge-tone tone-red">
                                                @String.Format("{0:+0.0;-0.0;0.0}%", item.ChangePercent)
                                            </span>
                                        </td>
                                        <td class="num-col">
                                            <strong class="text-negative">
                                                @item.Contribution.ToString("#,##0.##")
                                            </strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/morris/raphael-min.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/morris/morris.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}

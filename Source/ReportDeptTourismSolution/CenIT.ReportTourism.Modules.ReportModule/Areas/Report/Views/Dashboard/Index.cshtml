@model CenIT.ReportTourism.Models.Report.DashboardModel
@using System.Web.Mvc
@using TSFramework.App.Processors

@{
    ViewBag.Title = "Tổng quan sản xuất công nghiệp, xuất nhập khẩu";
}

@section Title { Tổng quan }

@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/morris/morris.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}

<div class="management-dashboard" id="managementDashboard">
    @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Overview", Filters = Model.Filters })

    <div class="dashboard-heading">
        <div>
            <h1 id="dashboard-content" tabindex="-1">Tình hình trong nhóm doanh nghiệp theo dõi</h1>
            <p>@Model.FilterSummary <span class="scope-badge">Không phải tổng doanh nghiệp toàn tỉnh</span></p>
        </div>
        <span class="dashboard-updated"><i class="fa fa-clock-o" aria-hidden="true"></i> Kỳ báo cáo: @Model.Filters.Month.ToString("00")/@Model.Filters.Year</span>
    </div>

    @Html.Partial("_DashboardFilters", Model.FilterOptions)

    <div class="row dashboard-row dashboard-kpi-row">
        <div class="col-xs-12">
            @Html.Partial("_StatisticEnterprise", Model)
        </div>
    </div>

    <div class="row dashboard-row dashboard-primary-row">
        <div class="col-md-8">
            @Html.Partial("_StatisticVisitor", Model)
        </div>
        <div class="col-md-4">
            @Html.Partial("_StatisticTypeBusiness", Model)
        </div>
    </div>

    <div class="row dashboard-row dashboard-secondary-row">
        <div class="col-md-5">
            @Html.Partial("_EnterpriseMovement", Model)
        </div>
        <div class="col-md-4">
            @Html.Partial("_DashboardSubmissionDetails", new CenIT.ReportTourism.Models.Report.DashboardSubmissionDetailsModel { Submission = Model.Submission, Filters = Model.Filters, ShowDetailsLink = true })
        </div>
        <div class="col-md-3">
            @Html.Partial("_DashboardAlerts", Model)
        </div>
    </div>
</div>

@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/morris/raphael-min.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/morris/morris.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}

@model CenIT.ReportTourism.Models.Report.DashboardModel
@using CenIT.ReportTourism.Models.Report
@using System.Linq
@{
    ViewBag.Title = DashboardText.Get("Overview_Title");
}
@section Title {
    @{ var pageNote = DashboardText.Get("Overview_ReceiptNote") + " " + Model.Classification.TypeZeroRows + "; " + DashboardText.Get("Overview_FutureRows") + " " + Model.Classification.FutureDatedRows + ". " + DashboardText.Get("Overview_ClassificationNote"); }
    @ViewBag.Title <span class="dashboard-page-note" tabindex="0" title="@pageNote"><i class="fa fa-info-circle" aria-hidden="true"></i><span class="sr-only">@pageNote</span></span>
}
@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/morris/morris.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}
@{
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var maxMovement = Model.Movements.Any() ? Model.Movements.Max(x => Math.Abs(x.Change)) : 0m;
}
<div class="management-dashboard dashboard-overview-page">
    <div class="nav-tabs-custom">
        @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Overview", Filters = Model.Filters })
        <div class="tab-content">
            @Html.Partial("_DashboardFilters", Model.FilterOptions)
        </div>
    </div>

    <div class="row dashboard-equal-row">
        @foreach (var card in Model.TypeCards)
        {
            var route = new { year = Model.Filters.Year, month = Model.Filters.Month, reportType = card.ReportType,
                areaId = Model.Filters.AreaId, economicSectorId = Model.Filters.EconomicSectorId,
                industryId = Model.Filters.IndustryId, enterpriseId = Model.Filters.EnterpriseId };
            var tone = card.ReportType == 1 ? "bg-light-blue" : card.ReportType == 2 ? "bg-green" : "bg-yellow";
            var icon = card.ReportType == 1 ? "fa-industry" : card.ReportType == 2 ? "fa-shopping-cart" : "fa-ship";
            <div class="col-xs-12 col-md-4">
                <div class="small-box @tone">
                    <div class="inner">
                        <h3>@card.Value <sup>@card.Unit</sup></h3>
                        <p><b>@DashboardText.Get("Overview_Type") @card.ReportType · @card.Name</b><br />@card.MetricLabel</p>
                        <p class="small">MoM @DashboardNumber.SignedPercent(card.Mom) · YoY @DashboardNumber.SignedPercent(card.Yoy)<br />
                            Có giá trị: @DashboardNumber.Count(card.MetricCoverage)/@DashboardNumber.Count(card.Assigned) DN</p>
                    </div>
                    <div class="icon"><i class="fa @icon" aria-hidden="true"></i></div>
                    <a class="small-box-footer" href="@Url.Action("Analysis", "Dashboard", route)" aria-label="@DashboardText.Get("Overview_AnalyzeReport") @card.Name">
                        <b>@DashboardNumber.Count(card.Received)/@DashboardNumber.Count(card.Assigned)</b> @DashboardText.Get("Overview_ReceivedAnalyze") <i class="fa fa-arrow-circle-right" aria-hidden="true"></i>
                    </a>
                </div>
                <p class="small"><a href="@Url.Action("Warnings","Dashboard",route)">@(card.Compared > 0 ? DashboardNumber.Count(card.Declines) + " DN giảm >10%" : "Chưa đủ dữ liệu lịch sử")</a> ·
                    <a href="@Url.Action("Progress","Dashboard",new { year=Model.Filters.Year,month=Model.Filters.Month,reportType=card.ReportType,areaId=Model.Filters.AreaId,economicSectorId=Model.Filters.EconomicSectorId,industryId=Model.Filters.IndustryId,enterpriseId=Model.Filters.EnterpriseId,status="incomplete" })">@DashboardNumber.Count(card.Incomplete) DN thiếu chỉ tiêu</a></p>
            </div>
        }
    </div>

    <div class="row dashboard-equal-row">
        <div class="col-xs-12 col-md-8">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-bar-chart text-light-blue" aria-hidden="true"></i> @DashboardText.Get("Overview_ReceivedTitle")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Overview_TrendSubtitle")</span></div>
                </div>
                <div class="box-body">
                    <div class="text-right"><button type="button" class="btn btn-default btn-xs dashboard-chart-toggle" data-chart-id="receipt-overview-chart" data-mode="rate">Tỷ lệ %</button> <button type="button" class="btn btn-default btn-xs dashboard-chart-toggle" data-chart-id="receipt-overview-chart" data-mode="count">Số doanh nghiệp</button></div>
                    <div id="receipt-overview-chart" data-labels="@(Newtonsoft.Json.JsonConvert.SerializeObject(new[] { DashboardText.Get("ChartType1"), DashboardText.Get("ChartType2"), DashboardText.Get("ChartType3") }))" data-empty="@DashboardText.Get("ChartEmpty")" class="chart dashboard-chart" role="img" aria-label="@DashboardText.Get("Overview_TrendAria")"></div>
                    <p class="text-muted small">Mẫu số lịch sử dùng danh mục được phân hiện tại; ba loại báo cáo có thể trùng doanh nghiệp.</p><ul class="list-inline text-center no-margin">
                        <li><i class="fa fa-square text-light-blue" aria-hidden="true"></i> @DashboardText.Get("ChartType1")</li>
                        <li><i class="fa fa-square text-green" aria-hidden="true"></i> @DashboardText.Get("ChartType2")</li>
                        <li><i class="fa fa-square text-yellow" aria-hidden="true"></i> @DashboardText.Get("ChartType3")</li>
                    </ul>
                    <script type="application/json" class="md-chart-data" data-chart="receipt-overview">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReceiptTrend))</script>
                </div>
                <div class="box-footer">
                    <button type="button" class="btn btn-link dashboard-values-toggle" data-toggle="collapse" data-target="#receipt-overview-values" aria-expanded="false" aria-controls="receipt-overview-values"><i class="fa fa-table" aria-hidden="true"></i> @DashboardText.Get("ChartValues")</button>
                    <div id="receipt-overview-values" class="collapse">
                        <div class="table-responsive">
                            <table class="table table-condensed table-striped">
                                <thead><tr><th>@DashboardText.Get("Month")</th><th class="text-right">@DashboardText.Get("ChartType1")</th><th class="text-right">@DashboardText.Get("ChartType2")</th><th class="text-right">@DashboardText.Get("ChartType3")</th></tr></thead>
                                <tbody>@foreach (var point in Model.ReceiptTrend) { <tr><td>@point.Month</td><td class="text-right">@DashboardNumber.Count(point.Type1)</td><td class="text-right">@DashboardNumber.Count(point.Type2)</td><td class="text-right">@DashboardNumber.Count(point.Type3)</td></tr> }</tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-md-4">
            <div class="box box-warning">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-tags text-yellow" aria-hidden="true"></i> @DashboardText.Get("Overview_Classification")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@(ViewBag.IsIndustryRestricted == true ? "Ngành được phân quyền" : DashboardText.Get("Overview_ProvinceWide"))</span></div>
                </div>
                <div class="box-body">
                    <h2 class="no-margin"><b>@DashboardNumber.Count(Model.Classification.NeedsClassification)</b> <small>@DashboardText.Get("Overview_NeedsClassification")</small></h2>
                    <ul class="list-group list-group-unbordered">
                        <li class="list-group-item">@DashboardText.Get("Overview_MissingBusiness") <span class="badge bg-yellow">@DashboardNumber.Count(Model.Classification.MissingBusinessRow)</span></li>
                        <li class="list-group-item">@DashboardText.Get("Overview_MissingIndustry") <span class="badge bg-yellow">@DashboardNumber.Count(Model.Classification.MissingIndustry)</span></li>
                        <li class="list-group-item">@DashboardText.Get("Overview_MissingReportType") <span class="badge bg-yellow">@DashboardNumber.Count(Model.Classification.MissingReportType)</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-exchange" aria-hidden="true"></i> @DashboardText.Get("Overview_LargestChanges") · @CenIT.ReportTourism.Biz.Report.ReportDashboardBiz.TypeName(Model.Filters.ReportType)</h3>
                    <div class="box-tools pull-right">
                        <a class="btn btn-box-tool" href="@Url.Action("Analysis", "Dashboard", new { year = Model.Filters.Year, month = Model.Filters.Month, reportType = Model.Filters.ReportType, areaId = Model.Filters.AreaId, economicSectorId = Model.Filters.EconomicSectorId, industryId = Model.Filters.IndustryId, enterpriseId = Model.Filters.EnterpriseId })">@DashboardText.Get("Overview_ViewAnalysis") <i class="fa fa-arrow-circle-right" aria-hidden="true"></i></a>
                    </div>
                </div>
                <div class="box-body @(Model.Movements.Any() ? "no-padding" : "")">
                    @if (!Model.Movements.Any())
                    {
                        <p class="text-muted text-center no-margin">@DashboardText.Get("Overview_NoComparison")</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead><tr><th style="width: 40px;">#</th><th>@DashboardText.Get("Enterprise")</th><th style="width: 30%;">@DashboardText.Get("Overview_ChangeSize")</th><th class="text-right">Biến động</th><th class="text-right">Tỷ lệ</th><th>Giải trình do doanh nghiệp cung cấp</th></tr></thead>
                                <tbody>
                                    @{ var rank = 0; }
                                    @foreach (var item in Model.Movements)
                                    {
                                        rank++;
                                        var tone = item.Change < 0 ? "red" : "green";
                                        var width = maxMovement > 0 ? Math.Abs(item.Change) * 100m / maxMovement : 0m;
                                        <tr>
                                            <td>@(rank).</td>
                                            <td><a class="dashboard-detail-link" href="@Url.Action("EnterpriseDetail","Dashboard",new { enterpriseId=item.EnterpriseId,year=Model.Filters.Year,month=Model.Filters.Month,reportType=Model.Filters.ReportType })">@item.Name</a></td>
                                            <td><div class="progress progress-xs"><div class="progress-bar progress-bar-@tone" style="width: @width.ToString("0.#", invariant)%"></div></div></td>
                                            <td class="text-right"><span class="badge bg-@tone">@DashboardNumber.Signed(item.Change)</span></td><td class="text-right">@DashboardNumber.SignedPercent(item.Percent)</td><td>@item.Reason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/morris/raphael-min.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/morris/morris.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}

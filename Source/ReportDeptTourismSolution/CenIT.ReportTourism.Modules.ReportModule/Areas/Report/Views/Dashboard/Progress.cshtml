@model CenIT.ReportTourism.Models.Report.DashboardProgressModel
@using CenIT.ReportTourism.Models.Report
@using System.Linq
@{
    ViewBag.Title = DashboardText.Get("Progress_Title");
}
@section Title {
    @{ var pageNote = DashboardText.Get("Progress_Note") + " " + DashboardText.Get("Progress_MetricNote"); }
    @ViewBag.Title <span class="dashboard-page-note" tabindex="0" title="@pageNote"><i class="fa fa-info-circle" aria-hidden="true"></i><span class="sr-only">@pageNote</span></span>
}
@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/morris/morris.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}
@{
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    Func<int, int, string> ratioWidth = (received, assigned) =>
        (assigned > 0 ? Math.Min(100m, 100m * received / assigned) : 0m).ToString("0.#", invariant);
}
<div class="management-dashboard dashboard-progress-page">
    <div class="nav-tabs-custom">
        @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Progress", Filters = Model.Filters })
        <div class="tab-content">
            @Html.Partial("_DashboardFilters", Model.FilterOptions)
        </div>
    </div>

    <div class="row dashboard-equal-row">
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-green">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.Received) <sup>/ @DashboardNumber.Count(Model.Assigned)</sup></h3>
                    <p><b>@DashboardText.Get("Progress_HasData")</b></p>
                </div>
                <div class="icon"><i class="fa fa-database" aria-hidden="true"></i></div>
                <div class="small-box-footer">Chưa nhập: @DashboardNumber.Count(Model.Assigned-Model.Received) DN · @DashboardText.Get("Progress_ObservedRatio") <b>@(Model.Assigned > 0 ? DashboardNumber.Percent(Model.CoveragePercent) : "—")</b></div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-aqua">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.Complete) <sup>@DashboardText.Get("Enterprises")</sup></h3>
                    <p><b>Đủ ba chỉ tiêu hợp lệ</b></p>
                </div>
                <div class="icon"><i class="fa fa-check-square-o" aria-hidden="true"></i></div>
                <div class="small-box-footer">@DashboardText.Get("Progress_IncludingZero")</div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-purple">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.Incomplete) <sup>@DashboardText.Get("Enterprises")</sup></h3>
                    <p><b>Thiếu chỉ tiêu hợp lệ</b></p>
                </div>
                <div class="icon"><i class="fa fa-files-o" aria-hidden="true"></i></div>
                <div class="small-box-footer">Cần đối chiếu: @DashboardNumber.Count(Model.Conflicts) DN</div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-teal">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.FileAnyType) <sup>@DashboardText.Get("Enterprises")</sup></h3>
                    <p><b>@DashboardText.Get("Progress_FileAnyType")</b></p>
                </div>
                <div class="icon"><i class="fa fa-file-text-o" aria-hidden="true"></i></div>
                <div class="small-box-footer">Mọi loại báo cáo; tệp được ghi nhận trễ: @DashboardNumber.Count(Model.FileLate)</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-success">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-line-chart text-green" aria-hidden="true"></i> @DashboardText.Get("Progress_ReceiptTrend")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Months12")</span></div>
                </div>
                <div class="box-body">
                    <p class="text-muted small">Mẫu số lịch sử dùng danh mục doanh nghiệp được phân hiện tại. Có tệp không đồng nghĩa đã nhập đủ chỉ tiêu cho loại báo cáo đang xem.</p>
                    <div class="text-right"><button type="button" class="btn btn-default btn-xs dashboard-chart-toggle" data-chart-id="observation-trend-chart" data-mode="rate">Tỷ lệ %</button> <button type="button" class="btn btn-default btn-xs dashboard-chart-toggle" data-chart-id="observation-trend-chart" data-mode="count">Số doanh nghiệp / tệp</button></div>
                    <div id="observation-trend-chart" data-labels="@(Newtonsoft.Json.JsonConvert.SerializeObject(new[] { DashboardText.Get("ChartReceived"), "Có tệp (mọi loại)" }))" data-empty="@DashboardText.Get("ChartEmpty")" class="chart dashboard-chart" role="img" aria-label="@DashboardText.Get("Progress_TrendAria") @Model.Filters.ReportType"></div>
                    <script type="application/json" class="md-chart-data" data-chart="observation-trend">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReceiptTrend))</script>
                </div>
                <div class="box-footer">
                    <button type="button" class="btn btn-link dashboard-values-toggle" data-toggle="collapse" data-target="#observation-trend-values" aria-expanded="false" aria-controls="observation-trend-values"><i class="fa fa-table" aria-hidden="true"></i> @DashboardText.Get("ChartValues")</button>
                    <div id="observation-trend-values" class="collapse">
                        <div class="table-responsive">
                            <table class="table table-condensed table-striped">
                                <thead><tr><th>@DashboardText.Get("Month")</th><th class="text-right">@DashboardText.Get("Progress_ReceivedEnterprise")</th><th>Tỷ lệ / danh mục hiện tại</th><th>Có tệp (mọi loại)</th></tr></thead>
                                <tbody>@foreach (var point in Model.ReceiptTrend) { <tr><td>@point.Month</td><td class="text-right">@DashboardNumber.Amount(point.Value)</td><td>@DashboardNumber.Percent(point.Rate) / @DashboardNumber.Count(point.Expected)</td><td>@DashboardNumber.Count(point.Files)</td></tr> }</tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-tasks text-aqua" aria-hidden="true"></i> @DashboardText.Get("Progress_MetricPresence")</h3>
                </div>
                <div class="box-body dashboard-breakdown-grid">
                    @foreach (var item in Model.MetricPresence)
                    {
                        <div class="progress-group">
                            <span class="progress-text">@item.Name</span>
                            <span class="progress-number"><b>@DashboardNumber.Count(item.Received)</b> / @DashboardNumber.Count(item.Assigned)</span>
                            <div class="progress sm"><div class="progress-bar progress-bar-aqua" style="width: @ratioWidth(item.Received, item.Assigned)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row dashboard-equal-row">
        <div class="col-xs-12 col-md-6">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-pie-chart" aria-hidden="true"></i> @DashboardText.Get("Analysis_SectorTitle")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Progress_ReceivedAssignedShort")</span></div>
                </div>
                <div class="box-body">
                    @if (!Model.Sectors.Any()) { <p class="text-muted no-margin">@DashboardText.Get("Progress_NoAssigned")</p> }
                    @foreach (var item in Model.Sectors.Take(6))
                    {
                        <div class="progress-group">
                            <span class="progress-text">@item.Name</span>
                            <span class="progress-number"><b>@DashboardNumber.Count(item.Received)</b> / @DashboardNumber.Count(item.Assigned)</span>
                            <div class="progress sm"><div class="progress-bar progress-bar-green" style="width: @ratioWidth(item.Received, item.Assigned)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-md-6">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-map-marker" aria-hidden="true"></i> @DashboardText.Get("Progress_ByArea")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Progress_ReceivedAssignedShort")</span></div>
                </div>
                <div class="box-body">
                    @if (!Model.Areas.Any()) { <p class="text-muted no-margin">@DashboardText.Get("Progress_NoAssigned")</p> }
                    @foreach (var item in Model.Areas.Take(10))
                    {
                        <div class="progress-group">
                            <span class="progress-text">@item.Name</span>
                            <span class="progress-number"><b>@DashboardNumber.Count(item.Received)</b> / @DashboardNumber.Count(item.Assigned)</span>
                            <div class="progress sm"><div class="progress-bar progress-bar-green" style="width: @ratioWidth(item.Received, item.Assigned)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-list-alt" aria-hidden="true"></i> @DashboardText.Get("Progress_Worklist")</h3>
                    <div class="box-tools pull-right"><span class="badge bg-light-blue">@DashboardNumber.Count(Model.TotalRows) @DashboardText.Get("Enterprises")</span></div>
                </div>
                <div class="box-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover table-condensed no-margin">
                            <thead><tr><th>@DashboardText.Get("Enterprise")</th><th>@DashboardText.Get("Area")</th><th>@DashboardText.Get("Progress_TypeData") @Model.Filters.ReportType</th><th>@DashboardText.Get("Progress_MissingCodes")</th><th>Trùng / đơn vị không hợp lệ</th><th>Tệp (mọi loại)</th><th>Giải trình do doanh nghiệp cung cấp</th></tr></thead>
                            <tbody>
                                @if (!Model.Enterprises.Any()) { <tr><td colspan="7" class="text-muted">@DashboardText.Get("Progress_NoAssigned")</td></tr> }
                                @foreach (var item in Model.Enterprises)
                                {
                                    <tr>
                                        <td><a class="dashboard-detail-link" href="@Url.Action("EnterpriseDetail","Dashboard",new { enterpriseId=item.EnterpriseId,year=Model.Filters.Year,month=Model.Filters.Month,reportType=Model.Filters.ReportType })">@item.Name</a><br /><small>@item.TaxCode</small></td>
                                        <td>@item.WardName</td>
                                        <td>@if (item.DataImported) { <span class="label label-success">@DashboardText.Get("Progress_HasData")</span> } else { <span class="label label-default">@DashboardText.Get("Progress_NoData")</span> }</td>
                                        <td>@if (String.IsNullOrEmpty(item.MissingMetricCodes)) { <span class="text-green">@DashboardText.Get("Progress_ThreeValues")</span> } else { @item.MissingMetricCodes }</td>
                                        <td>@if (item.MetricConflict) { <span class="label label-warning">@DashboardText.Get("Progress_Review")</span> } else { <span class="text-muted">—</span> }</td>
                                        <td>@(item.FileAnyType ? (item.FileLate ? "Có tệp · ghi nhận trễ" : "Có tệp") : "Chưa có tệp")</td><td>@item.Reason</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="box-footer clearfix">
                    <span class="text-muted small">Trang @Model.Filters.Page · @DashboardNumber.Count(Model.TotalRows) DN · @Model.PageSize DN/trang. Ngoài danh mục (@(ViewBag.IsIndustryRestricted == true ? "ngành được phân quyền" : "toàn tỉnh")): @DashboardNumber.Count(Model.Orphans) DN.</span>
                    <div class="pull-right btn-group btn-group-sm">
                        @if (Model.Filters.Page > 1) { <a class="btn btn-default" href="@Url.Action("Progress","Dashboard",new { year=Model.Filters.Year,month=Model.Filters.Month,reportType=Model.Filters.ReportType,areaId=Model.Filters.AreaId,economicSectorId=Model.Filters.EconomicSectorId,industryId=Model.Filters.IndustryId,enterpriseId=Model.Filters.EnterpriseId,status=Model.Filters.Status,page=Model.Filters.Page-1 })">Trước</a> }
                        @if ((long)Model.Filters.Page*Model.PageSize < Model.TotalRows) { <a class="btn btn-default" href="@Url.Action("Progress","Dashboard",new { year=Model.Filters.Year,month=Model.Filters.Month,reportType=Model.Filters.ReportType,areaId=Model.Filters.AreaId,economicSectorId=Model.Filters.EconomicSectorId,industryId=Model.Filters.IndustryId,enterpriseId=Model.Filters.EnterpriseId,status=Model.Filters.Status,page=Model.Filters.Page+1 })">Sau</a> }
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/morris/raphael-min.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/morris/morris.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}

@model CenIT.ReportTourism.Models.Report.DashboardModel
@using System.Linq
<section class="dashboard-panel trend-panel">
    <header class="panel-heading">
        <div><h2>Doanh thu công nghiệp theo tháng</h2><p>Tỷ đồng; chỉ hiển thị tháng có chỉ tiêu 0101</p></div>
        <span class="panel-period">@Model.Filters.Year</span>
    </header>
    @if (Model.MonthlyTrend.Count(x => x.GtsXcnIndex.HasValue) < 2) { <p class="dashboard-empty">Chưa đủ tháng báo cáo để thể hiện xu hướng.</p> }
    else { <div id="management-trend-chart" class="morris-chart" role="img" aria-label="Xu hướng doanh thu công nghiệp theo tháng"></div> }
    @if (Model.MonthlyTrend.Count(x => x.GtsXcnIndex.HasValue) >= 2) {
        <div class="chart-series-legend">
            <span><i class="series-gtsxcn" aria-hidden="true"></i> Doanh thu công nghiệp</span>
        </div>
    }
    <script type="application/json" class="md-chart-data" data-chart="trend">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyTrend))</script>
</section>

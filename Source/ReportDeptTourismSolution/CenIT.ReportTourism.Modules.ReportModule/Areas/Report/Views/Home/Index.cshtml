@{
    ViewBag.Title = "Report Module";
}

@section Title
{
    @ViewBag.Title
}

<h3> Kiểm tra </h3>

<button type="button" onclick="checkPlugin()" class="btn btn-primary">Check Plugin</button>
<button type="button" onclick="CheckToken()" class="btn btn-danger">Check Token</button>
<button type="button" onclick="GetVersion()" class="btn btn-warning">Get Version</button>
<button type="button" onclick="CheckBrowser()" class="btn btn-warning">Get Browser</button>

<br/>
<h3>Ký dữ liệu</h3>
<button type="button" onclick="chooseFile()" class="btn btn-primary">Chọn file </button>
<br/>
<textarea rows="1" col="100" id="filePath" style="width: 600px"></textarea>
<input type="file" class="hidden" id="fileinput"/>
<br/>
<button type="button" onclick="sign()" class="btn bg-navy">Ký </button>
<br/>

Dữ liệu ký base64 : <br/>
<textarea rows="10" col="100" id="output" style="width: 600px"></textarea>
<br/>
<textarea rows="10" col="100" id="fileBase" style="display: none;" style="width: 600px"></textarea>
<h3>Lấy thông tin chứng thư số</h3>
<button type="button" onclick="GetCertInfo()" class="btn btn-primary">Lấy thông tin </button>
<button type="button" onclick="ValidateCertificateBase64()" class="btn btn-primary">Kiểm tra CTS </button>
<br/>
Serial : <br/>
<textarea rows="1" col="100" id="serial" style="width: 600px"></textarea><br/><br/><br/><br/>
Base64 của CTS : <br/>
<textarea rows="10" col="100" id="base64Cert" style="width: 600px"></textarea>
<br/>

@section CustomJS
{
    @*<script src="~/Contents/Modules/Report/plugins/vnpt-ca/download.js"></script>*@
    <script src="~/Contents/Modules/Report/plugins/vnpt-ca/vnpt-plugin.js"></script>
    <script src="~/Contents/Modules/Report/plugins/vnpt-ca/base64.js"></script>

    <script type="text/javascript">
        var signInProcess = false;
        var checkCRLorOCSP = false;
        var key = "";

    </script>

    <script src="~/Areas/Report/Views/Home/Home.js"></script>

}
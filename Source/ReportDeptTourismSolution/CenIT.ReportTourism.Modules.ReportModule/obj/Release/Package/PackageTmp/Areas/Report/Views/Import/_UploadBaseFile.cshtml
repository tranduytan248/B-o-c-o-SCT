@model CenIT.ReportTourism.Models.Report.ReportDataImportModel
<div class="form-group">
    @Html.TitleFor(model => model.FileImport, new { @class = "control-label col-md-3" })
    <div class="col-md-9">
        @Html.FileFor(model => model.FileImport, ".xlsx,.xls", false, new { @class = "col-md-8" })
        @Html.ValidationMessageFor(model => model.FileImport, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group hidden" id="AdvancedSignArea">
    <label class="control-label col-md-3"></label>
    <div class="col-md-9">
        <div class="checkbox">
            @Html.CheckBox("AdvancedSign", false, new { id = "AdvancedSign", @class = "hidden" })
            <label for="AdvancedSign">Ký nâng cao</label>
        </div>
    </div>
</div>

@Html.HiddenFor(model => model.VNPTTokenSerialKey)
@Html.HiddenFor(model => model.FileName)
@Html.HiddenFor(model => model.FileExt)
@Html.HiddenFor(model => model.FileDataBase64)

<script src="~/Contents/Modules/Report/plugins/vnpt-ca/vnpt-plugin.js"></script>
<script src="~/Contents/Modules/Report/plugins/vnpt-ca/base64.js"></script>
<script src="~/Areas/Report/Views/Import/_VNPTToken.js"></script>

<script type="text/javascript">

    /* Sign plugin */
    $('#inputFile_FileImport button.btn-choose').click(function() {
        checkPlugin(checkPluginCallback);
    });

    $('#inputFile_FileImport button.btn-reset').click(function() {
        $("#DataImport #InputFileImport").load('@Url.Action("UploadBaseFile")');
    });

</script>
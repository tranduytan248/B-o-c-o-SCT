@model List<CenIT.ReportTourism.Models.Report.ReportDataImportModel>

<div class="row">
    <div class="col-md-12 table-responsive">
        <table id="DataReport" class="table table-bordered table-striped" width="100%">
            <thead>
            <tr>
                <th width="45%">Chỉ tiêu</th>
                <th width="10%">ĐV tính</th>
                <th width="5%">Mã số</th>
                <th width="13.3%">Số thực hiện kỳ trước</th>
                <th width="13.3%">Số thực hiện kỳ báo cáo</th>
                @*<th width="10%">Lũy kế từ đầu năm</th>*@
                <th width="13.3%">So với cùng kỳ năm trước (%)</th>
            </tr>
            </thead>
            <tbody>
            <tr class="text-center">
                <td>A</td>
                <td>B</td>
                <td>C</td>
                <td></td>
                <td>1</td>
                <td>2</td>
            </tr>
            @{
                var idx = 1;
                foreach (var rowData in Model)
                {
                    <tr>
                        @if (string.IsNullOrEmpty(rowData.Code))
                        {
                            <td colspan="6">
                                @Html.Hidden($"Target_{idx}", rowData.Targets)
                                @Html.Hidden($"Unit_{idx}", rowData.Unit)
                                @Html.Hidden($"Code_{idx}", rowData.Code)
                                @rowData.Targets
                            </td>
                        }
                        else
                        {
                            <td>
                                @Html.Hidden($"Target_{idx}", rowData.Targets)
                                @rowData.Targets
                            </td>
                            <td>
                                @Html.Hidden($"Unit_{idx}", rowData.Unit)
                                @rowData.Unit
                            </td>
                            <td>
                                @Html.Hidden($"Code_{idx}", rowData.Code.PadRight(2, '0'))
                                @rowData.Code.PadRight(2, '0')
                            </td>
                            <td>
                                @Html.TextBox($"PerformPreviousPeriod_{idx}", rowData.PerformPreviousPeriod, new { type = "number", min = "0", @class = "form-control text-right" })
                            </td>
                            <td>
                                @Html.TextBox($"PerformInPeriod_{idx}", rowData.PerformInPeriod, new { type = "number", min = "0", @class = "form-control text-right" })
                            </td>
                                @*<td>
                                        @Html.TextBox($"AccumulatedBeginingOfYear_{idx}", rowData.AccumulatedBeginingOfYear, new { type = "number", min = "0", @class = "form-control text-right" })
                                    </td>*@
                            <td>
                                @Html.TextBox($"CompareSamePeriodLastYear_{idx}", rowData.ComparedSamePeriodLastYear, new { type = "number", min = "0", @class = "form-control text-right" })
                            </td>
                        }
                    </tr>
                    idx = idx + 1;
                }
            }
            </tbody>
        </table>
    </div>
</div>
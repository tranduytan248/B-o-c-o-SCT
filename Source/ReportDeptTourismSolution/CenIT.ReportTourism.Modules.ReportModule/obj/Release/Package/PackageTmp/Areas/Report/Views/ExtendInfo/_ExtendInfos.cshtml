@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Report.ReportExtendInfoModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.Id)
<div id="ExtendInfo">
    @{
        if (Model.Id > 0)
        {
            <div class="form-group">
                @Html.LabelFor(model => model.ForMonth, new { @class = "control-label col-md-6" })
                <div class="col-md-3">
                    <div class="input-group disabled">
                        <div class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </div>
                        @Html.TextBoxFor(model => model.ForMonth, "{0:MM/yyyy}", new { disabled = true, @class = "form-control text-right", placeholder = "MM/yyyy" })
                        @Html.HiddenFor(model => model.ForMonth)
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="form-group">
                @Html.LabelFor(model => model.ForMonth, new { @class = "control-label col-md-6" })
                <div class="col-md-4">
                    <div class="input-group">
                        <div class="input-group-addon">
                            <i class="fa fa-calendar"></i>
                        </div>
                        @Html.TextBoxFor(model => model.ForMonth, "{0:MM/yyyy}", new { @class = "col-md-7", placeholder = "MM/yyyy" })
                    </div>
                </div>
            </div>
        }
    }
    <div class="form-group">
        @Html.TitleFor(model => model.TotalGuestViaShip, new { @class = "control-label col-md-6" })
        <div class="col-md-6">
            @Html.TextBoxFor(model => model.TotalGuestViaShip, new { @class = "col-md-5", onchange = "(function(el){el.value=parseInt(el.value);})(this)", type = "number", step = "1", min = 0, placeholder = "0", onblur = "OnFormatNumber(this);" })
            @Html.ValidationMessageFor(model => model.TotalGuestViaShip, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.TitleFor(model => model.Reason, new { @class = "control-label col-md-3" })
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.Reason, new { rows = "3", @class = "col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function() {
        $("#ExtendInfo #ForMonth").datepicker("remove");
        $("#ExtendInfo #ForMonth").datepicker({
            format: "mm/yyyy",
            viewMode: "months",
            minViewMode: "months",
            autoclose: true
        });
        $("#ExtendInfo #ForMonth").datepicker().trigger("update");
    });

    function OnFormatNumber(inptNumber) {
        var valueCurrency = $(inptNumber).val();
        $(inptNumber).val(parseInt(valueCurrency));
    }

</script>
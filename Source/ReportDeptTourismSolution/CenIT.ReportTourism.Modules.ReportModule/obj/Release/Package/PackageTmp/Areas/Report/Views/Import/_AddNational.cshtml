@using TSFramework.App.Processors
@model List<CenIT.ReportTourism.Models.Cate.CateNationalModel>
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("National_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    <div id="bodyForm">
        <div class="form-group">
            <label class="control-label col-md-3">@AppProcessor.Messagor.GetMessage("National_Title")</label>
            <div class="col-md-9">
                @Html.DropDownList("NationalCode", new SelectList(Model, "NationalCode", "NationalName"), "", new { multiple = true, @class = "col-md-9" })
                <span id="WarningNation" class="help-block text-red hidden">* Đã thêm tối đa 10 quốc tịch vào báo cáo.</span>
            </div>
        </div>
    </div>
}

@section SubmitControl{
    <button type="button" id="btnSave" class="btn btn-primary" onclick="addNational()"><i class="fa fa-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add")</button>
}
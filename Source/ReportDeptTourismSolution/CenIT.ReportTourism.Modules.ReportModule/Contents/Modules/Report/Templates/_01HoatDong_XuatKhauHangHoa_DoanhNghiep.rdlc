<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- Top Left: Form number & reception date -->
      <Textbox Name="TxtTopLeft1">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Biểu số: 01-CS/XKHH</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Ngày nhận báo cáo:</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Ngày 12 tháng sau tháng báo cáo</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontStyle>Italic</FontStyle>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.1in</Top>
        <Left>0.1in</Left>
        <Height>0.6in</Height>
        <Width>2.6in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>

      <!-- Top Right: Receiving Agency -->
      <Textbox Name="TxtTopRight">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Đơn vị nhận báo cáo:</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Right</TextAlign></Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Cục Thống Kê tỉnh Khánh Hòa</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Right</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.1in</Top>
        <Left>6.85in</Left>
        <Height>0.6in</Height>
        <Width>3.0in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>

      <!-- Center Title -->
      <Textbox Name="TxtTitle">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>BÁO CÁO</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>13pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>HOẠT ĐỘNG XUẤT KHẨU HÀNG HÓA</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>(Áp dụng đối với doanh nghiệp có hoạt động xuất khẩu hàng hóa)</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontStyle>Italic</FontStyle>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="(Tháng " &amp; Parameters!p_Month.Value &amp; " năm " &amp; Parameters!p_Year.Value &amp; ")"</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>10pt</FontSize>
                  <FontStyle>Italic</FontStyle>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.75in</Top>
        <Left>0.1in</Left>
        <Height>0.9in</Height>
        <Width>9.75in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <!-- Enterprise Info: Business Name & Tax Code Label -->
      <Textbox Name="TxtEnterpriseName">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Tên doanh nghiệp: </Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>10pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!p_EnterpriseName.Value</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>10pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>1.72in</Top>
        <Left>0.1in</Left>
        <Height>0.24in</Height>
        <Width>6.6in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <Textbox Name="TxtTaxLabel">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Mã số thuế doanh nghiệp:</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Right</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>1.72in</Top>
        <Left>6.7in</Left>
        <Height>0.24in</Height>
        <Width>3.15in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <!-- Address & Tax Code Boxes -->
      <Textbox Name="TxtAddress">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Địa chỉ: </Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!p_Address.Value</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>1.98in</Top>
        <Left>0.1in</Left>
        <Height>0.24in</Height>
        <Width>6.6in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <!-- Tax Box 10 digits -->
      <Textbox Name="TxtTaxBox">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!p_TaxCode.Value</Value>
                <Style>
                  <FontFamily>Courier New</FontFamily>
                  <FontSize>10.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>1.98in</Top>
        <Left>7.4in</Left>
        <Height>0.24in</Height>
        <Width>2.45in</Width>
        <Style>
          <Border>
            <Style>Solid</Style>
            <Color>#555555</Color>
          </Border>
          <BackgroundColor>#f9f9f9</BackgroundColor>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <!-- Phone and Email -->
      <Textbox Name="TxtContact">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Điện thoại: </Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!p_Phone.Value</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>      Email: </Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!p_Email.Value</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>2.24in</Top>
        <Left>0.1in</Left>
        <Height>0.24in</Height>
        <Width>9.75in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <!-- Main Business Industry & Industry Code -->
      <Textbox Name="TxtIndustry">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Ngành sản xuất kinh doanh chính: </Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!p_MainIndustryName.Value</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>2.5in</Top>
        <Left>0.1in</Left>
        <Height>0.24in</Height>
        <Width>7.2in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <Textbox Name="TxtIndustryCodeLabel">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Mã ngành:</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Right</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>2.5in</Top>
        <Left>7.3in</Left>
        <Height>0.24in</Height>
        <Width>1.2in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <Textbox Name="TxtIndustryCodeBox">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!p_MainIndustryCode.Value</Value>
                <Style>
                  <FontFamily>Courier New</FontFamily>
                  <FontSize>10.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>2.5in</Top>
        <Left>8.6in</Left>
        <Height>0.24in</Height>
        <Width>1.25in</Width>
        <Style>
          <Border>
            <Style>Solid</Style>
            <Color>#555555</Color>
          </Border>
          <BackgroundColor>#f9f9f9</BackgroundColor>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <!-- Economic Sector -->
      <Textbox Name="TxtEconomic">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Loại hình kinh tế doanh nghiệp: </Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!p_EconomicSectorName.Value</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>9.5pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>2.76in</Top>
        <Left>0.1in</Left>
        <Height>0.24in</Height>
        <Width>9.75in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>

      <!-- Main Data Table -->
      <Tablix Name="Tablix1">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>3.2in</Width></TablixColumn>
            <TablixColumn><Width>0.75in</Width></TablixColumn>
            <TablixColumn><Width>0.85in</Width></TablixColumn>
            <TablixColumn><Width>1.1in</Width></TablixColumn>
            <TablixColumn><Width>0.85in</Width></TablixColumn>
            <TablixColumn><Width>1.1in</Width></TablixColumn>
            <TablixColumn><Width>0.85in</Width></TablixColumn>
            <TablixColumn><Width>1.05in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <!-- Header Row 1 -->
            <TablixRow>
              <Height>0.28in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_ColA_Top">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_ColB_Top">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Grp1">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Thực hiện tháng báo cáo</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                    <ColSpan>2</ColSpan>
                  </CellContents>
                </TablixCell>
                <TablixCell />
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Grp2">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Cộng dồn từ đầu năm đến cuối tháng báo cáo</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                    <ColSpan>2</ColSpan>
                  </CellContents>
                </TablixCell>
                <TablixCell />
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Grp3">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Dự tính tháng tiếp theo</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                    <ColSpan>2</ColSpan>
                  </CellContents>
                </TablixCell>
                <TablixCell />
              </TablixCells>
            </TablixRow>

            <!-- Header Row 2 (Sub-headers) -->
            <TablixRow>
              <Height>0.28in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_ColA">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Tên chỉ tiêu</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_ColB">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Đơn vị tính</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Sub1">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Lượng</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Sub2">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Giá trị (1,000 USD)</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Sub3">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Lượng</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Sub4">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Giá trị (1,000 USD)</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Sub5">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Lượng</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H_Sub6">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Giá trị (1,000 USD)</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#f2f4f7</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Header Row 3 (Column indices A, B, 1..6) -->
            <TablixRow>
              <Height>0.22in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Idx_A">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>A</Value><Style><FontFamily>Times New Roman</FontFamily><FontSize>9pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>#555555</Color></Border><BackgroundColor>#fafafa</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

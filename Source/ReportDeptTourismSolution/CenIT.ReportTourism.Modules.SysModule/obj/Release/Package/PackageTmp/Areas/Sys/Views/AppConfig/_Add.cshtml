@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("AppConfig_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "AppConfig", new {area = "Sys"}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AppConfig_OnProcessSuccess(data, 'AddAppConfig')"
    }, new {@class = "form-horizontal"}))
    {
        <div id="bodyForm">
            @Html.Partial("_AppConfig")
        </div>
    }
}
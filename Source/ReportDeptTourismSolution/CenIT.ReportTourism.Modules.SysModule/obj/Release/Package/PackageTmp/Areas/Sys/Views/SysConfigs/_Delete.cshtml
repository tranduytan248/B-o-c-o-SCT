@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysConfigsModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("SysConfig_Title"));
    Layout = "~/Views/Shared/_FormDel.cshtml";
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "SysConfigs", new {area = "Sys"}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AppConfig_OnProcessSuccess(data, 'DeleteConfig')"
    }, new {@class = "form-horizontal"}))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ConfigId)
        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
    }
}
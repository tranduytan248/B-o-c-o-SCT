<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronEveryHour" name="cronHour" checked="checked">
            <label for="cronEveryHour">Every hour</label>
        </div>
    </div>
</div>
<div class="form-group">
    <div class="col-md-1">
        <div class="radio col-md-12">
            <input type="radio" id="cronHourIncrement" name="cronHour">
            <label for="cronHourIncrement">Every</label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronHourIncrementIncrement" class="col-md-8">
            @{
                for (var idx = 1; idx <= 24; idx++)
                {
                    <option value="@idx">@idx</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="control-label"> hour(s) starting at hour </label>
    </div>
    <div class="col-md-2">
        <select id="cronHourIncrementStart" class="col-md-8">
            @{
                for (var idx = 0; idx < 24; idx++)
                {
                    <option value="@idx">@(idx.ToString().PadLeft(2, '0'))</option>
                }
            }
        </select>
    </div>
</div>
<div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <input type="radio" id="cronHourSpecific" checked="checked" name="cronHour">
            <label for="cronHourSpecific">
                Specific hour (choose one or many)
            </label>
        </div>
    </div>
    <div class="col-md-1">
    </div>
    @{
        var isCheckHour = false;
        for (var idx = 0; idx < 24; idx++)
        {
            if (idx % 10 == 0)
            {
                <div class="col-md-1"></div>
            }
            var eleId = $"cronHour{idx}";

            <div class="col-md-1">
                <div class="checkbox">
                    @{
                        if (!isCheckHour)
                        {
                            <input type="checkbox" id="@eleId" name="cronHourSpecificSpecific" value="@idx"
                                   checked="checked">
                            isCheckHour = true;
                        }
                        else
                        {
                            <input type="checkbox" id="@eleId" name="cronHourSpecificSpecific" value="@idx">
                        }
                    }
                    <label for="@eleId">@(idx.ToString().PadLeft(2, '0'))</label>
                </div>
            </div>
            if (idx % 10 == 9)
            {
                <div class="col-md-1"></div>
            }
        }
    }

    <div class="col-md-1">
    </div>
</div>
<div class="form-group">
    <div class="col-md-4">
        <div class="radio col-md-12">
            <input type="radio" id="cronHourRange" name="cronHour">
            <label for="cronHourRange">
                Every hour between hour
            </label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronHourRangeStart" class="col-md-8">
            @{
                for (var idx = 0; idx < 24; idx++)
                {
                    <option value="@idx">@(idx.ToString().PadLeft(2, '0'))</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="control-label"> and hour </label>
    </div>
    <div class="col-md-2">
        <select id="cronHourRangeEnd" class="col-md-8">
            @{
                for (var idx = 0; idx < 24; idx++)
                {
                    <option value="@idx">@(idx.ToString().PadLeft(2, '0'))</option>
                }
            }
        </select>
    </div>
</div>
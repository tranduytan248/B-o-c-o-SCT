@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysConfigsModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("SysConfig_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-pencil"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Edit", "SysConfigs", new {area = "Sys"}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AppConfig_OnProcessSuccess(data, 'EditConfig')"
    }, new {@class = "form-horizontal"}))
    {
        <div id="bodyForm">
            @Html.Partial("_SysConfig", Model)
        </div>
    }
}
@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("AppLayout_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-pencil"></i>
}

@section FormBody{

    @using (Html.BeginForm("Edit", "AppLayout", new {area = "Sys"}, FormMethod.Post, new {encType = "multipart/form-data", id = "EditAppLayout", @class = "form-horizontal"}))
    {
        <div id="bodyForm">
            @Html.Partial("_AppLayout")
        </div>
    }
    <script type="text/javascript">
        $('form').ajaxForm({
            success: function(response) {
                if (response.status != undefined) {
                    $("#ModalContent #modal_EditAppLayout").modal("hide");
                    $("#ModalContent #modal_EditAppLayout").on('hidden.bs.modal',
                        function() {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableAppLayout.ajax.reload(null, true);
                                response.status = undefined;
                            }
                        });
                } else {
                    $("#ModalContent #modal_EditAppLayout" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}
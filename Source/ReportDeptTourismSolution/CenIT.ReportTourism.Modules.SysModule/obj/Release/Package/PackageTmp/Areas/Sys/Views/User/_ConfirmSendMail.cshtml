@model CenIT.ReportTourism.Models.Sys.SysUserModel

@{
    ViewBag.Title = $"Reset mật khẩu cho tài khoản - [{Model.FullName} - {Model.UserName}]";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section ModalType{
    bg-yellow
}

@section FormBody{

    @using (Ajax.BeginForm("SendMail", "User", new {area = "Sys"}, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "User_OnProcessSuccess(data, 'ConfirmSendMail')"
    }, new {@class = "form-horizontal"}))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.UserId)
        @Html.HiddenFor(model => model.UserName)
        @Html.HiddenFor(model => model.FullName)
        @Html.HiddenFor(model => model.Email)
        @Html.HiddenFor(model => model.Reason)

        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
        <hr/>
    }
}
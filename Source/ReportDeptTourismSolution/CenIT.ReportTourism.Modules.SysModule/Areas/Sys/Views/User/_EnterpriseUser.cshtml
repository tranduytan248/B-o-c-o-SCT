@using TSFramework.App.Processors
@model CenIT.ReportTourism.Modules.SysModule.Areas.Sys.Models.EnterpriseUserModel

@Html.HiddenFor(model => model.UserName)
@Html.HiddenFor(model => model.FullName)
@Html.HiddenFor(model => model.Email)

<link rel="stylesheet" href="~/Contents/Modules/Sys/plugins/bootstrap-multiselect/css/bootstrap-multiselect.css" type="text/css" />

<div id="PermissionEnterprise">
    <div class="form-group">
        <div class="col-md-4">
            @Html.TitleFor(model => model.UserName, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.UserName, new { @class = "col-md-12 form-control", disabled = true, placeholder = AppProcessor.Messagor.GetMessage("User_Label_UserName") })
            @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-8">
            @Html.TitleFor(model => model.FullName, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.FullName, new { @class = "col-md-12 form-control", disabled = true, placeholder = AppProcessor.Messagor.GetMessage("User_Label_FullName") })
            @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.StrEnterprisesSelected, new { @class = "control-label" })
            <div class="col-md-12 row">
                @Html.DropDownList("SelectedEnterprises", new SelectList(Model.Enterprises, "Value", "Text"),
                    new { @class = "col-md-12 form-control none-select2", multiple = "multiple", placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select_Enterprises") })
            </div>
        </div>
        @Html.HiddenFor(model => model.StrEnterprisesSelected)
    </div>

    <script type="text/javascript" src="~/Contents/Modules/Sys/plugins/bootstrap-multiselect/js/bootstrap-multiselect.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('select#SelectedEnterprises').multiselect({
                maxHeight: 400,
                numberDisplayed: 1,
                includeSelectAllOption: true,
                selectAllNumber: true,
                selectAllText: 'Chọn/Bỏ chọn tất cả!',
                nonSelectedText: 'Chọn doanh nghiệp',
                resetText: "Reset",
                enableFiltering: true,
                enableCaseInsensitiveFiltering: true,
                includeResetOption: true,
                includeResetDivider: true,
                filterPlaceholder: 'Tìm kiếm doanh nghiệp',
                allSelectedText: 'Chọn tất cả',
                nSelectedText: 'doanh nghiệp đã được chọn',
                enableClickableOptGroups: true,
                enableCollapsibleOptGroups: true,
                onChange: function (option, checked, select) {
                    var selectedValues = $('input[type="hidden"][id$="StrEnterprisesSelected"]').val();
                    var arrSelectedValues = selectedValues != undefined && selectedValues.length > 0
                        ? selectedValues.split(',')
                        : [];
                    var idxOpt = arrSelectedValues.indexOf($(option).val());

                    if (checked) {
                        if (idxOpt < 0) {
                            arrSelectedValues.push($(option).val());
                            $('input[type="hidden"][id$="StrEnterprisesSelected"]').val(arrSelectedValues);
                        }
                    } else {
                        if (idxOpt > -1) {
                            arrSelectedValues.splice(idxOpt, 1);
                            $('input[type="hidden"][id$="StrEnterprisesSelected"]').val(arrSelectedValues);
                        }
                    }
                },
                onSelectAll: function () {
                    var arrSelectedValues = $('select#SelectedEnterprises option:selected')
                        .map(function (a, item) { return item.value; });
                    $('input[type="hidden"][id$="StrEnterprisesSelected"]').val(arrSelectedValues.toArray());
                },
                onDeselectAll: function (options) {
                    $('input[type="hidden"][id$="StrEnterprisesSelected"]').val('');
                }
            });
        });

        $(function () {
            var selectedValues = $('input[type="hidden"][id$="StrEnterprisesSelected"]').val();
            $('select#SelectedEnterprises').multiselect('select', selectedValues.split(","));
        });
    </script>
</div>
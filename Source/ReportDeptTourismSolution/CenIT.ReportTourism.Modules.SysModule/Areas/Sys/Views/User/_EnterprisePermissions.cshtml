@model CenIT.ReportTourism.Modules.SysModule.Areas.Sys.Models.EnterpriseUserModel
@{
    ViewBag.Title = $"Phân quyền doanh nghiệp - [{Model.FullName}]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("EnterprisesUser", "User", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "User_OnProcessSuccess(data, 'EnterprisesUser')"
    }, new { @class = "form-horizontal" }))
    {
        <div class="modal-body" id="PermissionEnterprise">
            @Html.Partial("_EnterpriseUser")
        </div>
    }
}
@using System.Globalization
<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronEveryMonth" name="cronMonth" checked="checked">
            <label for="cronEveryMonth">Every month</label>
        </div>
    </div>
</div>
<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronMonthIncrement" name="cronMonth">
            <label for="cronMonthIncrement">Every</label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronMonthIncrementIncrement" class="col-md-8">
            @{
                for (var idx = 1; idx <= 12; idx++)
                {
                    <option value="@idx">@idx</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="control-label"> month(s) starting in </label>
    </div>
    <div class="col-md-3">
        <select id="cronMonthIncrementStart" class="col-md-10">
            @{
                for (var idx = 1; idx <= 12; idx++)
                {
                    <option value="@idx">@(CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(idx))</option>
                }
            }
        </select>
    </div>
</div>
<div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <input type="radio" id="cronMonthSpecific" name="cronMonth">
            <label for="cronMonthSpecific">Specific month (choose one or many)</label>
        </div>
    </div>
    @{
        for (var idx = 1; idx <= 12; idx++)
        {
            if (idx % 5 == 1)
            {
                <div class="col-md-2"></div>
            }
            var eleId = $"cronMonth{idx}";

            <div class="col-md-2">
                <div class="checkbox">
                    @{
                        <input type="checkbox" id="@eleId" name="cronMonthSpecificSpecific" value="@(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(idx))">
                    }
                    <label for="@eleId">@(CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(idx))</label>
                </div>
            </div>
        }
    }
</div>
<div class="form-group">
    <div class="col-md-3">
        <div class="radio">
            <input type="radio" id="cronMonthRange" name="cronMonth">
            <label for="cronMonthRange">Every month between</label>
        </div>
    </div>
    <div class="col-md-3">
        <select id="cronMonthRangeStart" class="col-md-8">
            @{
                for (var idx = 1; idx <= 12; idx++)
                {
                    <option value="@idx">@(CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(idx))</option>
                }
            }
        </select>
    </div>
    <div class="col-md-1">
        <label class="control-label col-md-4"> and </label>
    </div>
    <div class="col-md-3">
        <select id="cronMonthRangeEnd" class="col-md-8">
            @{
                for (var idx = 1; idx <= 12; idx++)
                {
                    <option value="@idx">@(CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(idx))</option>
                }
            }
        </select>
    </div>
</div>
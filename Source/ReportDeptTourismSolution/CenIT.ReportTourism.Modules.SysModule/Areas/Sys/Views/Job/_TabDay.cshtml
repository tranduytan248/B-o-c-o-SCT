<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronEveryDay" name="cronDay" checked="checked">
            <label for="cronEveryDay">Every day</label>
        </div>
    </div>
</div>
<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronDowIncrement" name="cronDay">
            <label for="cronDowIncrement">Every</label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronDowIncrementIncrement" class="col-md-8">
            @{
                for (var idx = 1; idx <= 7; idx++)
                {
                    <option value="@idx">@idx</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="control-label"> day(s) starting on </label>
    </div>
    <div class="col-md-3">
        <select id="cronDowIncrementStart" class="col-md-10">
            @{
                for (var idx = 1; idx <= 7; idx++)
                {
                    <option value="@idx">@(((DayOfWeek)(idx - 1)).ToString())</option>
                }
            }
        </select>
    </div>
</div>
<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronDomIncrement" name="cronDay">
            <label for="cronDomIncrement">Every</label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronDomIncrementIncrement" class="col-md-8">
            @{
                for (var idx = 1; idx <= 31; idx++)
                {
                    <option value="@idx">@idx</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="control-label"> day(s) starting on the</label>
    </div>
    <div class="col-md-2">
        <select id="cronDomIncrementStart" class="col-md-8">
            <option value="1">1st</option>
            <option value="2">2nd</option>
            <option value="3">3rd</option>
            @{
                for (var idx = 4; idx <= 31; idx++)
                {
                    <option value="@idx">@(idx)th</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="control-label"> of the month</label>
    </div>
</div>
<div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <input type="radio" id="cronDowSpecific" name="cronDay">
            <label for="cronDowSpecific">Specific day of week (choose one or many)</label>
        </div>
    </div>
    <div class="col-md-2">
    </div>
    <div class="col-md-2 checkbox">
        <input type="checkbox" id="cronDowSun" name="cronDowSpecificSpecific" value="SUN">
        <label for="cronDowSun">Sunday</label>
    </div>
    <div class="col-md-2 checkbox">
        <input type="checkbox" id="cronDowMon" name="cronDowSpecificSpecific" value="MON">
        <label for="cronDowMon">Monday</label>
    </div>
    <div class="col-md-2 checkbox">
        <input type="checkbox" id="cronDowTue" name="cronDowSpecificSpecific" value="TUE">
        <label for="cronDowTue">Tuesday</label>
    </div>
    <div class="col-md-2 checkbox">
        <input type="checkbox" id="cronDowWed" name="cronDowSpecificSpecific" value="WED">
        <label for="cronDowWed">Wednesday</label>
    </div>
    <div class="col-md-3">
    </div>
    <div class="col-md-2 checkbox">
        <input type="checkbox" id="cronDowThu" name="cronDowSpecificSpecific" value="THU">
        <label for="cronDowThu">Thursday</label>
    </div>
    <div class="col-md-2 checkbox">
        <input type="checkbox" id="cronDowFri" name="cronDowSpecificSpecific" value="FRI">
        <label for="cronDowFri">Friday</label>
    </div>
    <div class="col-md-2 checkbox">
        <input type="checkbox" id="cronDowSat" name="cronDowSpecificSpecific" value="SAT">
        <label for="cronDowSat">Saturday</label>
    </div>
</div>
<div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <input type="radio" id="cronDomSpecific" name="cronDay">
            <label for="cronDomSpecific">Specific day of month (choose one or many)</label>
        </div>
    </div>
    <div class="col-md-1">
    </div>
    @{
        var isCheckDay = false;
        for (var idx = 1; idx <= 31; idx++)
        {
            if (idx % 10 == 1)
            {
                <div class="col-md-1"></div>
            }
            var eleId = $"cronDom{idx}";

            <div class="col-md-1">
                <div class="checkbox">
                    @{
                        if (!isCheckDay)
                        {
                            <input type="checkbox" id="@eleId" name="cronDomSpecificSpecific" value="@idx"
                                   checked="checked">
                            isCheckDay = true;
                        }
                        else
                        {
                            <input type="checkbox" id="@eleId" name="cronDomSpecificSpecific" value="@idx">
                        }
                    }
                    <label for="@eleId">@(idx.ToString().PadLeft(2, '0'))</label>
                </div>
            </div>
            if (idx % 10 == 0)
            {
                <div class="col-md-1"></div>
            }
        }
    }
    <div class="col-md-1">
    </div>
</div>
<div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <input type="radio" id="cronLastDayOfMonth" name="cronDay">
            <label for="cronLastDayOfMonth">On the last day of the month</label>
        </div>
    </div>
</div>
<div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <input type="radio" id="cronLastWeekdayOfMonth" name="cronDay">
            <label for="cronLastWeekdayOfMonth">On the last weekday of the month</label>
        </div>
    </div>
</div>
<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronLastSpecificDom" name="cronDay">
            <label for="cronLastSpecificDom">On the last</label>
        </div>
    </div>
    <div class="col-md-3">
        <select id="cronLastSpecificDomDay" class="col-md-10">
            @{
                for (var idx = 1; idx <= 7; idx++)
                {
                    <option value="@idx">@(((DayOfWeek)(idx - 1)).ToString())</option>
                }
            }
        </select>
    </div>
</div>
<div class="form-group">
    <div class="col-md-1">
        <div class="radio">
            <input type="radio" id="cronDaysBeforeEom" name="cronDay">
            <label for="cronDaysBeforeEom"></label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronDaysBeforeEomMinus" class="col-md-8">
            @{
                for (var idx = 1; idx <= 31; idx++)
                {
                    <option value="@idx">@idx</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="control-label"> day(s) before the end of the month</label>
    </div>
</div>
<div class="form-group">
    <div class="col-md-5">
        <div class="radio">
            <input type="radio" id="cronDaysNearestWeekdayEom" name="cronDay">
            <label for="cronDaysNearestWeekdayEom">Nearest weekday (Monday to Friday) to the</label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronDaysNearestWeekday" class="col-md-8">
            <option value="1">1st</option>
            <option value="2">2nd</option>
            <option value="3">3rd</option>
            @{
                for (var idx = 4; idx <= 31; idx++)
                {
                    <option value="@idx">@(idx)th</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="control-label"> of the month</label>
    </div>
</div>
<div class="form-group">
    <div class="col-md-2">
        <div class="radio">
            <input type="radio" id="cronNthDay" name="cronDay">
            <label for="cronNthDay">On the</label>
        </div>
    </div>
    <div class="col-md-2">
        <select id="cronNthDayNth" class="col-md-8">
            <option value="1">1st</option>
            <option value="2">2nd</option>
            <option value="3">3rd</option>
            <option value="4">4th</option>
            <option value="5">5th</option>
        </select>
    </div>
    <div class="col-md-3">
        <select id="cronNthDayDay" class="col-md-10">
            @{
                for (var idx = 1; idx <= 7; idx++)
                {
                    <option value="@idx">@(((DayOfWeek)(idx - 1)).ToString())</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="control-label"> of the month</label>
    </div>
</div>
<script type="text/javascript" src="~/Contents/Modules/Sys/plugins/bootstrap-multiselect/js/bootstrap-multiselect.js"></script>

<script type="text/javascript">
    $(document).ready(function() {
        $('#PermissionModule select#SelectedUsers').multiselect({
            maxHeight: 400,
            numberDisplayed: 1,
            includeSelectAllOption: true,
            selectAllNumber: true,
            selectAllText: 'Chọn tất cả!',
            nonSelectedText: 'Chọn người dùng',
            resetText: "Bỏ chọn tất cả",
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true,
            includeResetOption: true,
            includeResetDivider: true,
            filterPlaceholder: 'Tìm kiếm người dùng',
            allSelectedText: 'Chọn tất cả',
            nSelectedText: 'người dùng đã được chọn',
            enableClickableOptGroups: true,
            enableCollapsibleOptGroups: true,
            onChange: function(option, checked, select) {
                var selectedValues = $('#PermissionModule input[type="hidden"][id$="PermissionUserIDs"]').val();
                var arrSelectedValues = selectedValues != undefined && selectedValues.length > 0
                    ? selectedValues.split(',')
                    : [];
                var idxOpt = arrSelectedValues.indexOf($(option).val());

                if (checked) {
                    if (idxOpt < 0) {
                        arrSelectedValues.push($(option).val());
                        $('#PermissionModule input[type="hidden"][id$="PermissionUserIDs"]').val(arrSelectedValues);
                    }
                } else {
                    if (idxOpt > -1) {
                        arrSelectedValues.splice(idxOpt, 1);
                        $('#PermissionModule input[type="hidden"][id$="PermissionUserIDs"]').val(arrSelectedValues);
                    }
                }
            },
            onSelectAll: function() {
                var arrSelectedValues = $('#PermissionModule select#SelectedUsers option:selected')
                    .map(function(a, item) { return item.value; });
                $('#PermissionModule input[type="hidden"][id$="PermissionUserIDs"]').val(arrSelectedValues.toArray());
            },
            onDeselectAll: function() {
                $('#PermissionModule input[type="hidden"][id$="PermissionUserIDs"]').val('');
            }
        });
    });

    $(function() {
        var selectedValues = $('#PermissionModule input[type="hidden"][id$="PermissionUserIDs"]').val();
        $('#PermissionModule select#SelectedUsers').multiselect('select', selectedValues.split(","));
    });
</script>